import * from "CR_BZBase.material"
material crhpnew3 : CR_BZBase
{
    set_texture_alias DiffuseMap crhpnew3_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap black.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".15 .15 .15"
    set $shininess "32"
}
material crhpnew3/trim : crhpnew3
{
    set $diffuse "0.24 0.24 0.24"
    set $ambient "0.24 0.24 0.24"
}
