import * from "BZBase.material"

material hvraz_BZBase_hvsav00 : BZBase
{
	set_texture_alias DiffuseMap hvsav00_D.dds
	set_texture_alias NormalMap flat_N.dds
	set_texture_alias SpecularMap black.dds
	set_texture_alias EmissiveMap black.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}


