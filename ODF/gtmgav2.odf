// CR turret barrel variant: gtminig firing in turn across 4 barrels (stock turret had 2)
// shotAlternate rotates the 4 slots; shotDelay 0.2 x 4/2 = 0.4 keeps shots/s and ammo/s stock.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored minigun: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_minigun.mesh"
flashMaterial = "CR/Muzzle/minigun"
flashDuration = 0.045
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Ballistic small brass; local cosmetic only.
casingType = "small"
// CR WEAPON CASING END
classLabel = "machinegun"
ordName = "bullet5"
shotAlternate = 1
wpnName = "Minigun"
fireSound = "gmini00.wav"
wpnReticle = "gminigun"
wpnPriority = 1
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.4
