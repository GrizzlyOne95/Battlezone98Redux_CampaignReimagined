// CCA APC infantry plasma assault rifle: ~93.3 DPS per soldier.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored plasmared: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_plasmared.mesh"
flashMaterial = "CR/Muzzle/plasmared"
flashDuration = 0.06
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Energy, launcher, explosive or utility: no ejected brass.
casingType = "none"
// CR WEAPON CASING END
classLabel = "machinegun"
ordName = "ssplblt"
wpnName = "CCA Infantry Plasma Assault Rifle"
fireSound = "gmsov00.wav"
wpnReticle = "gminigun"
wpnPriority = 1
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.30
shotVariance = 0.025
