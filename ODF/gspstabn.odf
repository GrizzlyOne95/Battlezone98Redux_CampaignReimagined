[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored spstab: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_spstab.mesh"
flashMaterial = "CR/Muzzle/spstab"
flashDuration = 0.095
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Ballistic large brass; local cosmetic only.
casingType = "large"
// CR WEAPON CASING END
// CR WEAPON RECOIL BEGIN
// Opt-in recoil: the craft supplies the node/distance/return, this weapon supplies the kick.
// A craft's recoilKick<N> overrides it (e.g. 0.15 for a scout's miniguns). Machineguns get none.
recoilKick = 1.0
// CR WEAPON RECOIL END
baseName = "gatstab"
classLabel = "cannon"
ordName = "rocket3n"
wpnName = "SP-Stabber"
fireSound = "gmagg03.wav"
wpnReticle = "gspstab"
wpnPriority = 5
wpnCategory = "CANN"

[CannonClass]
shotDelay = 1.5
