// ============================================================
// CR CRA death explosion, DETONATE stage (xdcrad)
// Look: yellow-green chemical flash, lime glints, olive soot.
// Budget: 9 particles (stock xcarxplb is 9), one light. Gameplay fields copied from xcarxplb.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
explRadius = 10.0
explSound = "xcar.wav"
damageRadius = 20.0
damageBallistic = 0
damageConcussion = 100
damageFlame = 0
damageImpact = 0

particleTypes = 6

particleClass1 = "xdcrad.Flash"
particleCount1 = 1
particleVeloc1 = "0.00 0.00 0.00"

particleClass2 = "xdcrad.Core"
particleCount2 = 1
particleVeloc2 = "0.00 1.00 0.00"
particleBias2 = "0.00 2.00 0.00"

particleClass3 = "xdcrad.Debris"
particleCount3 = 2
particleVeloc3 = "6.00 6.00 6.00"
particleBias3 = "0.00 3.00 0.00"

particleClass4 = "xdcrad.Ember"
particleCount4 = 2
particleVeloc4 = "5.00 4.00 5.00"
particleBias4 = "0.00 2.00 0.00"

particleClass5 = "xdcrad.Smoke"
particleCount5 = 2
particleVeloc5 = "2.00 1.00 2.00"
particleBias5 = "0.00 1.00 0.00"

particleClass6 = "xdcrad.Light"
particleCount6 = 1
particleVeloc6 = "0.00 2.00 0.00"
particleBias6 = "0.00 5.00 0.00"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.30
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "240 255 175 255"
finishColor = "120 200 0 0"
startRadius = 8.00
finishRadius = 16.00
animateTime = 0.30

