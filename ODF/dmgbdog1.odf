// ============================================================
// CR Black Dog damage, LIGHT stage (dmgbdog1)
// Look: lean, fast, near-black column from the first stage; crimson sparks (sparks join from stage 2).
// Budget: ~27 live sprites (optimized dmgvhcl1 is ~40).
// ============================================================

[Dmgbdog1]
renderBase = "draw_twirl_trail"
