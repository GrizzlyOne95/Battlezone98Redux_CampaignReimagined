// ============================================================
// CR CRA death explosion, INITIAL stage (xdcrai)
// Look: yellow-green chemical flash, lime glints, olive soot.
// Budget: 9 particles (stock xcarxpla is 9), one light. Gameplay fields copied from xcarxpla.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
explRadius = 10.0
explSound = "xcar.wav"
damageRadius = 20.0
damageBallistic = 0
damageConcussion = 100
damageFlame = 0
damageImpact = 0

particleTypes = 5

particleClass1 = "xdcrai.Flash"
particleCount1 = 1
particleVeloc1 = "0.00 0.00 0.00"

particleClass2 = "xdcrai.Core"
particleCount2 = 1
particleVeloc2 = "0.00 1.00 0.00"
particleBias2 = "0.00 2.00 0.00"

particleClass3 = "xdcrai.Ember"
particleCount3 = 4
particleVeloc3 = "5.00 4.00 5.00"
particleBias3 = "0.00 2.00 0.00"

particleClass4 = "xdcrai.Smoke"
particleCount4 = 2
particleVeloc4 = "2.00 1.00 2.00"
particleBias4 = "0.00 1.00 0.00"

particleClass5 = "xdcrai.Light"
particleCount5 = 1
particleVeloc5 = "0.00 2.00 0.00"
particleBias5 = "0.00 5.00 0.00"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.25
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "240 255 175 255"
finishColor = "120 200 0 0"
startRadius = 7.00
finishRadius = 14.00
animateTime = 0.25

[Core]
simulateBase = "sim_smoke"
lifeTime = 1.00
renderBase = "draw_twirl"
textureName = "cr_xpl_core.dds"
textureBlend = "one one modulate"
startColor = "215 255 125 255"
finishColor = "90 170 0 0"
startRadius = 3.50
finishRadius = 11.00
animateTime = 1.00
rotationRate = 3.00

[Ember]
simulateBase = "sim_ember"
lifeTime = 1.60
renderBase = "draw_twirl"
textureName = "cr_xpl_glint.dds"
textureBlend = "one one modulate"
startColor = "200 255 110 255"
finishColor = "60 170 0 0"
startRadius = 0.40
finishRadius = 0.20
animateTime = 1.60
rotationRate = 8.00

[Smoke]
simulateBase = "sim_smoke"
lifeTime = 3.50
renderBase = "draw_twirl"
textureName = "cr_xpl_smoke.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "66 74 46 215"
finishColor = "28 34 18 0"
startRadius = 2.50
finishRadius = 7.00
animateTime = 3.50
rotationRate = 3.00

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.6
renderBase = "draw_light"
startColor = "200 255 150 255"
finishColor = "110 190 30 0"
startRadius = 20.00
finishRadius = 20.00
animateTime = 0.6
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0
