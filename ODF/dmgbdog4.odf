// ============================================================
// CR Black Dog damage, CRITICAL stage (dmgbdog4)
// Look: lean, fast, near-black column from the first stage; crimson sparks.
// Budget: ~68 live sprites + one flicker light (optimized dmgvhcl4 is ~80).
// ============================================================

[Dmgbdog4]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "dmgbdog4.smokeemitter"
renderName2 = "dmgbdog4.flameemitter"
renderName3 = "dmgbdog4.sparkemitter"
renderName4 = "dmgbdog4.lightemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.03
emitVelocity = "0.0 7.0 0.0"
emitVariance = "1.2 1.2 1.2"
emitInherit = "0.2 0.2 0.2"
emitLife = 1.8
textureName = "cr_xpl_smoke.dds"
startColor = "8 6 6 96"
finishColor = "8 6 6 0"
startRadius = 0.9
finishRadius = 2.2
animateTime = 1.8
rotationRate = 3.0

[FlameEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 7.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.3 0.3 0.3"
emitLife = 0.8
textureName = "flame2.tga"
startColor = "255 200 180 140"
finishColor = "200 0 0 0"
startRadius = 0.5
finishRadius = 0.15
animateTime = 0.8
rotationRate = 10.0

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 4.0 0.0"
emitVariance = "5.0 5.0 5.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 0.8
textureName = "cr_xpl_spark.dds"
startColor = "255 120 100 255"
finishColor = "160 0 0 0"
startRadius = 0.2
finishRadius = 0.06
animateTime = 0.8
rotationRate = 20.0

[LightEmitter]
renderBase = "draw_emit"
emitName = "dmgbdog4.light"
emitDelay = 0.2
emitDelayVar = 0.1
emitVelocity = "0 0 0"
emitVariance = "0.0 0.0 0.0"
emitInherit = "1.0 1.0 1.0"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.2
renderBase = "draw_light"
startColor = "255 110 90 160"
finishColor = "255 80 60 110"
startRadius = 6.0
finishRadius = 4.5
animateTime = 0.2
attenuateConstant = 0.0
attenuateLinear = 0.0
attenuateQuadratic = 1.0
lensFlare = false
