[ExplosionClass]
classLabel = "explosion"

particleTypes = 3

particleClass1 = "xc17jhit.puff"
particleCount1 = 1
particleVeloc1 = "0 0 0"
particleBias1 = "0 1 0"

particleClass2 = "xc17jhit.bark"
particleCount2 = 4
particleVeloc2 = "6 5 6"
particleBias2 = "0 6 0"

particleClass3 = "xc17jhit.leaf"
particleCount3 = 3
particleVeloc3 = "5 4 5"
particleBias3 = "0 5 0"

explSound = "c17crack.wav"
damageRadius = 0.0
damageBallistic = 0
damageConcussion = 0
damageFlame = 0
damageImpact = 0

[puff]
simulateBase = "sim_smoke"
