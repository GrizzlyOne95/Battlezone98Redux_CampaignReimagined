[CraftClass]
// CR CRAFT FLASH OFFSET BEGIN
// Visible barrel tip from the hardpoint (right up forward, metres); replaces the
// weapon's flashOffset for this craft. Regenerate: Tools/Build-WeaponFlashes.py --measure
flashOffset1 = "0.20 0.10 2.41"
// CR CRAFT FLASH OFFSET END
// OpenShim mesh recoil (slot 1 cannon barrel; needs Settings > Video > Muzzle Recoil).
// Node AGR11BGA is the dedicated barrel under the turret (per VDF); metres, m/s.
// Follows slot 1 if weaponName1 changes. See avtank.odf for the full reference.
recoilName1 = "AGR11BGA"
recoilDistance1 = 0.30
recoilReturn1 = 2.5
