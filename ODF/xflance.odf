// Plasma Lance (flance) impact, all surfaces: blue plasma burst, shock ring, sparks, scorch.
// Splash: concussion 120 over 14 m (betblow-style), on top of the orb's 220 direct ballistic.
// Hand-written: flance is a CR weapon, so Tools/Build-WeaponHitFx.py (stock ordnance only) does not own it.
[ExplosionClass]
classLabel = "explosion"
explSound = "xmv1.wav"
damageRadius = 14.0
damageBallistic = 0
damageConcussion = 120
damageFlame = 0
damageImpact = 0

particleTypes = 7

particleClass1 = "xflance.Flash"
particleCount1 = 1
particleVeloc1 = "0.00 0.00 0.00"

particleClass2 = "xflance.PlasmaA"
particleCount2 = 1
particleVeloc2 = "0.00 0.00 0.00"

particleClass3 = "xflance.PlasmaB"
particleCount3 = 1
particleVeloc3 = "0.00 0.00 0.00"

particleClass4 = "xflance.Ring"
particleCount4 = 1
particleVeloc4 = "0.00 0.00 0.00"

particleClass5 = "xflance.Spark"
particleCount5 = 4
particleVeloc5 = "9.00 7.00 9.00"
particleBias5 = "0.00 1.50 0.00"

particleClass6 = "xflance.Scorch"
particleCount6 = 1
particleVeloc6 = "0.00 0.00 0.00"

particleClass7 = "xflance.Light"
particleCount7 = 1
particleVeloc7 = "0.00 0.00 0.00"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.22
renderBase = "draw_sprite"
textureName = "cr_xpl_core.dds"
textureBlend = "one one modulate"
startColor = "215 235 255 255"
finishColor = "40 100 255 0"
startRadius = 1.00
finishRadius = 4.00
