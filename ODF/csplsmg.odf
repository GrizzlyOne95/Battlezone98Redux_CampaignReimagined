// CRA APC infantry plasma repeater: 100 DPS per soldier.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored plasmagreen: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_plasmagreen.mesh"
flashMaterial = "CR/Muzzle/plasmagreen"
flashDuration = 0.06
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
classLabel = "machinegun"
ordName = "csplblt"
wpnName = "CRA Infantry Plasma Repeater"
fireSound = "gmini00.wav"
wpnReticle = "gminigun"
wpnPriority = 1
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.10
shotVariance = 0.030
