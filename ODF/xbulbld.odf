// Building bullet hit. Particle budget 6 (was 9): flash 1, concrete chips 2, hot sparks 3.
[ExplosionClass]
classLabel = "explosion"

//frameName = "xbulh.0"
//frameCount = 5
//frameDelay = 0.1
//explRadius = 0.5
explSound = "wmgr1.wav"
damageRadius = 0.0
damageBallistic = 0
damageConcussion = 0
damageFlame = 0
damageImpact = 0

particleTypes = 3

particleClass1 = "xbulbld.Flash"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"

particleClass2 = "xbulbld.Chunk"
particleCount2 = 2
particleVeloc2 = "4.0 4.0 4.0"
particleBias2 = "0.0 2.0 0.0"

particleClass3 = "xbulbld.Spark"
particleCount3 = 3
particleVeloc3 = "6.0 5.0 6.0"
particleBias3 = "0.0 2.0 0.0"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.2
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "255 220 160 255"
finishColor = "255 110 40 0"
startRadius = 0.2
finishRadius = 0.5
animateTime = 0.2

[Chunk]
simulateBase = "sim_ember"
lifeTime = 1.0
renderBase = "draw_twirl"
textureName = "cr_xpl_debris.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "150 150 145 255"
finishColor = "110 110 105 0"
startRadius = 0.08
finishRadius = 0.06
animateTime = 1.0
rotationRate = 6.0

[Spark]
simulateBase = "sim_ember"
lifeTime = 0.4
renderBase = "draw_twirl"
textureName = "cr_xpl_spark.dds"
textureBlend = "one one modulate"
startColor = "255 230 140 255"
finishColor = "255 70 10 0"
startRadius = 0.15
finishRadius = 0.05
animateTime = 0.4
rotationRate = 20.0
