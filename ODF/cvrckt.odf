// CRA initial death blast (ODF/xdcrai)
explosionName = "xdcrai"
// CR DEATH FX END

[CraftClass]
// CR CRAFT FLASH OFFSET BEGIN
// Flash point from the hardpoint (right up forward, metres: barrel tip, or 0 0 0 at
// a muzzle-face hardpoint); replaces the weapon's flashOffset for this craft.
// Regenerate: Tools/Build-WeaponFlashes.py --measure
flashOffset1 = "0.26 -0.01 0.01"
flashOffset2 = "-0.29 -0.01 0.01"
flashOffset3 = "0.00 0.00 0.00"
// CR CRAFT FLASH OFFSET END
// CR CRAFT RECOIL BEGIN
// Reviewed independent gun pieces; preserve aiming and deployment parents.
// Regenerate: python Tools/Build-CombatPresentation.py
recoilAnimation1 = "cr_fire_1"
recoilPlaybackRate1 = 1.0
recoilCockpit1 = true
casingOffset1 = "0.6531 0.2486 -0.298"
casingDirection1 = "0.9345 0.3271 -0.1402"
recoilKick1 = 1.0
recoilAnimation2 = "cr_fire_2"
recoilPlaybackRate2 = 1.0
recoilCockpit2 = true
casingOffset2 = "-0.6766 0.2568 -0.3015"
casingDirection2 = "-0.9345 0.3271 -0.1402"
recoilKick2 = 1.0
// CR CRAFT RECOIL END
rangeScan = 270.0
periodScan = 5.0f
velocJam = 5.0f
selectAttackMsg = "cvrcktv0.wav"
selectGoMsg = "cvrcktv1.wav"
selectFollowMsg = "cvrcktvg.wav"
selectOtherMsg = "cvrcktvm.wav"
goMsg = "cvrcktvk.wav"
goObjectMsg = "cvrcktvf.wav"
attackMsg = "cvrcktv2.wav"
followMeMsg = "cvrcktv4.wav"
followMsg = "cvrcktvb.wav"
repairMsg = "cvrcktv8.wav"
reloadMsg = "cvrcktv9.wav"
rescueMsg = "cvrcktvc.wav"
recycleMsg = "cvrcktvd.wav"
otherMsg = "cvrcktvk.wav"
user1Msg = "cvrcktva.wav"
killedMsg = "cvrcktv3.wav"
diedMsg = "abetty3.wav"
cloakAllowed = "True"
// CR DAMAGE FX BEGIN
// CRA damage smoke (ODF/dmgcra1-4.odf)
damageEffect1 = "dmgcra1"
damageEffect2 = "dmgcra2"
damageEffect3 = "dmgcra3"
damageEffect4 = "dmgcra4"
// CR DAMAGE FX END
// CR DEATH FX BEGIN
// CRA death explosions (ODF/xdcras, xdcrad, xdcrap)
xplSnipe = "xdcrap"
xplSecondary = "xdcras"
xplDetonate = "xdcrad"
// CR DEATH FX END


[HoverCraftClass]
setAltitude = 1.0
accelDragStop = 3.5
accelDragFull = 1.0
