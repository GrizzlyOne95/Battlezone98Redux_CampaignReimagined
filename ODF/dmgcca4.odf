// ============================================================
// CR CCA damage, CRITICAL stage (dmgcca4)
// Look: fat, slow, lingering diesel soot; chunky orange sparks.
// Budget: ~68 live sprites + one flicker light (optimized dmgvhcl4 is ~80).
// ============================================================

[Dmgcca4]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "dmgcca4.smokeemitter"
renderName2 = "dmgcca4.flameemitter"
renderName3 = "dmgcca4.sparkemitter"
renderName4 = "dmgcca4.lightemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.08
emitDelayVar = 0.03
emitVelocity = "0.0 3.0 0.0"
emitVariance = "2.5 2.5 2.5"
emitInherit = "0.2 0.2 0.2"
emitLife = 2.6
textureName = "cr_xpl_smoke.dds"
startColor = "35 30 22 90"
finishColor = "35 30 22 0"
startRadius = 1.6
finishRadius = 3.6
animateTime = 2.6
rotationRate = 1.0

[FlameEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 4.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.3 0.3 0.3"
emitLife = 1.1
textureName = "flame2.tga"
startColor = "255 210 140 140"
finishColor = "230 70 0 0"
startRadius = 0.8
finishRadius = 0.25
animateTime = 1.1
rotationRate = 10.0

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.08
emitDelayVar = 0.02
emitVelocity = "0.0 2.0 0.0"
emitVariance = "6.0 6.0 6.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 1.1
textureName = "spark.tga"
startColor = "255 200 80 255"
finishColor = "220 70 0 0"
startRadius = 0.35
finishRadius = 0.12
animateTime = 1.1
rotationRate = 20.0

[LightEmitter]
renderBase = "draw_emit"
emitName = "dmgcca4.light"
emitDelay = 0.2
emitDelayVar = 0.1
emitVelocity = "0 0 0"
emitVariance = "0.0 0.0 0.0"
emitInherit = "1.0 1.0 1.0"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.2
renderBase = "draw_light"
startColor = "255 170 90 175"
finishColor = "255 150 70 125"
startRadius = 6.0
finishRadius = 4.5
animateTime = 0.2
attenuateConstant = 0.0
attenuateLinear = 0.0
attenuateQuadratic = 1.0
lensFlare = false
