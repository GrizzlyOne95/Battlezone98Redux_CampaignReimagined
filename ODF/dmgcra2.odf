// ============================================================
// CR CRA damage, MEDIUM stage (dmgcra2)
// Look: pale yellow-green chemical vapour going to olive soot; lime glints.
// Budget: ~48 live sprites (optimized dmgvhcl2 is ~60).
// ============================================================

[Dmgcra2]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "dmgcra2.smokeemitter"
renderName2 = "dmgcra2.sparkemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.06
emitDelayVar = 0.03
emitVelocity = "0.0 4.0 0.0"
emitVariance = "2.5 2.5 2.5"
emitInherit = "0.2 0.2 0.2"
emitLife = 2.0
textureName = "cr_xpl_wisp.dds"
startColor = "165 175 125 52"
finishColor = "165 175 125 0"
startRadius = 1.0
finishRadius = 2.6
animateTime = 2.0
rotationRate = 1.5

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.06
emitDelayVar = 0.02
emitVelocity = "0.0 3.0 0.0"
emitVariance = "4.0 4.0 4.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 0.9
textureName = "cr_xpl_glint.dds"
startColor = "220 255 140 255"
finishColor = "60 170 0 0"
startRadius = 0.3
finishRadius = 0.1
animateTime = 0.9
rotationRate = 20.0
