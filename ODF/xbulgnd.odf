// Ground bullet hit. Particle budget 4 (was 5): flash 1, dirt kicks 2, dust puff 1.
[ExplosionClass]
classLabel = "groundblast"

//frameName = "xbulg.0"
//frameCount = 10
//frameDelay = 0.1
//explRadius = 0.5
explSound = "wmgr2.wav"
damageRadius = 0.0
damageBallistic = 0
damageConcussion = 0
damageFlame = 0
damageImpact = 0

particleTypes = 3

particleClass1 = "xbulgnd.Flash"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"

particleClass2 = "xbulgnd.Chunk"
particleCount2 = 2
particleVeloc2 = "4.0 4.0 4.0"
particleBias2 = "0.0 4.0 0.0"

particleClass3 = "xbulgnd.Puff"
particleCount3 = 1
particleVeloc3 = "0.0 0.0 0.0"
particleBias3 = "0.0 0.5 0.0"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.2
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "255 190 110 255"
finishColor = "255 90 30 0"
startRadius = 0.12
finishRadius = 0.3
animateTime = 0.2

[Chunk]
simulateBase = "sim_ember"
lifeTime = 1.2
renderBase = "draw_twirl"
textureName = "cr_fx_dirt.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "64 64 64 255"
finishColor = "64 64 64 0"
startRadius = 0.12
finishRadius = 0.12
animateTime = 1.2
rotationRate = 5.0
useTerrainColor = true

[Puff]
simulateBase = "sim_smoke"
lifeTime = 1.5
renderBase = "draw_sprite"
spriteCenter.x = 0.0
spriteCenter.y = 1.0
textureName = "cr_xpl_wisp.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "192 192 192 110"
finishColor = "128 128 128 0"
startRadius = 0.3
finishRadius = 1.5
animateTime = 1.5
useTerrainColor = true
