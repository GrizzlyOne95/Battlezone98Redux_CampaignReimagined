// Small central pop when the Betty triggers/dies.
// The stock Prox Mine's power is intentionally shifted into directional shrapnel.
[ExplosionClass]
classLabel = "explosion"
explSound = "xpdeb2.wav"
damageRadius = 18.0
damageBallistic = 0
damageConcussion = 120
damageFlame = 0
damageImpact = 0
particleTypes = 3

particleClass1 = "betblow.flash"
particleCount1 = 1
particleVeloc1 = "0.0 0.0 0.0"

particleClass2 = "betblow.smoke"
particleCount2 = 2
particleVeloc2 = "2.0 5.0 2.0"
particleBias2 = "0.0 2.0 0.0"

particleClass3 = "betblow.light"
particleCount3 = 1
particleVeloc3 = "0.0 0.0 0.0"

[Flash]
simulateBase = "sim_smoke"
lifeTime = 0.25
renderBase = "draw_twirl"
textureName = "flame.tga"
textureBlend = "one one modulate"
startColor = "255 225 120 255"
finishColor = "255 95 10 0"
startRadius = 1.0
finishRadius = 4.0
animateTime = 0.25
rotationRate = 6.0

[Smoke]
simulateBase = "sim_smoke"
lifeTime = 1.4
renderBase = "draw_twirl"
textureName = "smoke2.tga"
startColor = "90 85 75 130"
finishColor = "70 65 60 0"
startRadius = 1.2
finishRadius = 4.5
animateTime = 1.4
rotationRate = 5.0

[Light]
simulateBase = "sim_null"
lifeTime = 0.25
renderBase = "draw_light"
startColor = "255 205 80 255"
finishColor = "255 105 15 0"
startRadius = 20.0
finishRadius = 7.0
animateTime = 0.25
