// ============================================================
// CR Black Dog death explosion, SNIPE stage (xdbdogp)
// Look: tight hot flash, crimson embers, fast near-black column.
// Budget: 6 particles (stock xsecxpla is 5 + 2 allowed). Gameplay fields copied from xsecxpla.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
