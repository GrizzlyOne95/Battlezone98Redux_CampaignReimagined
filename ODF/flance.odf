// Fury Plasma Lance orb (hvturr): slow blue plasma ball, splash on impact.
// Render pattern follows plasma.odf (emitted twirls + light); blue only, with a trail.
[OrdnanceClass]
classLabel = "rocket"

shotGeometry = NULL
xplGround = "xflance"
xplVehicle = "xflance"
xplBuilding = "xflance"

renderName = "flance.render"

ammoCost = 0
lifeSpan = 2.9
shotSpeed = 70.0
damageBallistic = 220
damageConcussion = 0
damageFlame = 0
damageImpact = 0

[RocketClass]
flareRadius = 0.0
flareTexture = "plasma.0"
flareFrames = 4

[Render]
renderBase = "draw_multi"
renderCount = 5
renderName1 = "flance.shell"
renderName2 = "flance.core"
renderName3 = "flance.shell2"
renderName4 = "flance.light"
renderName5 = "flance.trail"

[Shell]
simulateBase = "sim_smoke"
lifeTime = 0.2
renderBase = "draw_emit"
emitName = "flance.shellemit"
emitDelay = 0.2
emitVelocity = "0.0 0.0 0.0"
emitVariance = "0.0 0.0 0.0"
emitInherit = "1.0 1.0 1.0"

