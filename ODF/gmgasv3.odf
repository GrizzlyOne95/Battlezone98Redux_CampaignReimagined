// CR turret barrel variant: gminigna with 1/3 damage per barrel (ordnance omgasv3)
// Made by the hardpoint pass; re-derive it if the base ODF changes.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored minigun: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_minigun.mesh"
flashMaterial = "CR/Muzzle/minigun"
flashDuration = 0.045
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Ballistic small brass; local cosmetic only.
casingType = "small"
// CR WEAPON CASING END
baseName = "gminigun"
classLabel = "machinegun"
ordName = "omgasv3"
wpnName = "Minigun"
fireSound = "gmini00.wav"
wpnReticle = "gminigun"
wpnPriority = 0
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.40

