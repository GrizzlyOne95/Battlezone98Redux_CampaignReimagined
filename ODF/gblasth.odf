[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored blastred: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_blastred.mesh"
