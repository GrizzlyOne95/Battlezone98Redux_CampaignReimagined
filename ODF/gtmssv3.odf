// CR turret barrel variant: gtminis with 1/3 damage per barrel (ordnance otmssv3)
// Made by the hardpoint pass; re-derive it if the base ODF changes.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored chaingun: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_chaingun.mesh"
flashMaterial = "CR/Muzzle/chaingun"
flashDuration = 0.055
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Ballistic small brass; local cosmetic only.
casingType = "small"
// CR WEAPON CASING END
classLabel = "machinegun"
ordName = "otmssv3"
wpnName = "Chaingun"
fireSound = "gmsov00.wav"
wpnReticle = "gminigun"
wpnPriority = 1
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.30
