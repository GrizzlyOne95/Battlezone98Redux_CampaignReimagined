[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored plasmared: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_plasmared.mesh"
flashMaterial = "CR/Muzzle/plasmared"
flashDuration = 0.06
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Energy, launcher, explosive or utility: no ejected brass.
casingType = "none"
// CR WEAPON CASING END
// CR WEAPON RECOIL BEGIN
// Opt-in recoil: the craft supplies the node/distance/return, this weapon supplies the kick.
// A craft's recoilKick<N> overrides it (e.g. 0.15 for a scout's miniguns). Machineguns get none.
recoilKick = 1.0
// CR WEAPON RECOIL END
classLabel = "cannon"
ordName = "splasma"
wpnName = "CCA Plasma Assault Rifle"
fireSound = "ghand00.wav"
wpnReticle = "gminigun"
wpnPriority = 0
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.22
shotVariance = 0.025
salvoCount = 1
salvoDelay = 0.0
shotPitch = 0.0
