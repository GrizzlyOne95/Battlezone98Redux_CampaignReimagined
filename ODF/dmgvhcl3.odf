// ==================
// HEAVY DAMAGE STATE
// CR: spark emit rate trimmed to 20/s
// (brown smoke + flame + sparks)
// ==================

[DmgVhcl3]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "dmgvhcl3.smokeemitter"
renderName2 = "dmgvhcl3.flameemitter"
renderName3 = "dmgvhcl3.sparkemitter"
renderName4 = "dmgvhcl3.lightemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.03
emitVelocity = "0.0 5.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.2 0.2 0.2"
emitLife = 2.0
textureName = "smoke2.tga"
startColor = "68 51 34 64"
finishColor = "68 51 34 0"
startRadius = 1.0
finishRadius = 2.0
animateTime = 2.0
rotationRate = 2.0

[FlameEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 5.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.3 0.3 0.3"
emitLife = 0.7
textureName = "flame2.tga"
startColor = "255 255 200 128"
finishColor = "255 0 0 0"
startRadius = 0.5
finishRadius = 0.1
animateTime = 0.7
rotationRate = 10.0

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 5.0 0.0"
emitVariance = "5.0 5.0 5.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 1.0
textureName = "spark.tga"
startColor = "255 255 0 255"
finishColor = "255 0 0 0"
startRadius = 0.2
finishRadius = 0.1
animateTime = 1.0
rotationRate = 20.0

[Lightemitter]
renderBase = "draw_emit"
emitName = "dmgvhcl3.light"
emitDelay = 0.2 //0.2 //0.16
emitDelayVar = 0.15
emitVelocity = "0 0 0" //0.0 0.0 0.0
emitVariance = "0.0 0.0 0.0"
emitInherit = "1.0 1.0 1.0"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.2
renderBase = "draw_light"
startColor = "255 255 200 175"
finishColor = "255 255 200 125"
startRadius = 7.0
finishRadius = 5.0
animateTime = 0.2
attenuateConstant = 0.0
attenuateLinear = 0.0
attenuateQuadratic = 1.0
lensFlare = false
