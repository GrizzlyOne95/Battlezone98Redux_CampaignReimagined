// Campaign Reimagined: stock misn09.aip with its build items switched from Soviet
// (sv*) to American (av*) units. misns1 loads misn09.aip for an American base,
// whose factory cannot build Soviet units, so the stock plan built nothing.
/*****************************************************************************

  Default.AIP

 *****************************************************************************/

#include "aipdef.h"

int VERBOSE_SCHEDULER = 0;

// How often do we recompute the strategy?
int recompute_strategy_period = 10;

// PRIORITIES
int escort_priority = 1100;
int min_escort_force = 1;
int max_escort_force = 1;
int ground_unit_threat = 5; //not used
int threat_priority = 500;
int distance_priority = -1;  // was -1
int defend_buildings_priority = 1000;
int attack_enemy_base_priority = 500; //50
int persistence_priority = 5;
int exploration_priority = 300; //50
int scripted_priority = 1200;
int single_use_group_priority = 30;//not used
int perimeter_priority = 20; //50

// TROOP COMMITMENT STUFF 
double min_matching_force_ratio = 2.0;
double max_matching_force_ratio = 2.0;

// When generic troops are called for, what should be ratio of troops that can
// shoot ground targets to troops that can shoot air targets?
double generic_ground_ratio = 1.0;

int min_building_defense_force = 0.5;
int max_building_defense_force = 1.0;

int min_exploration_force = 1;
int max_exploration_force = 1;

int min_perimeter_force = 1;
int max_perimeter_force = 1;

int min_escort_force = 1;
int max_escort_force = 1;

// RELAXATION STUFF 
int relaxation_cycles = 0;
float relaxation_coefficient = .5;

// Scheduler goals stuff
// -1 = unlimited
#define MAX_DEFEND_BASE_GOALS 5

#define MAX_ATTACK_TROOPS_GOALS 2

#define MAX_SEIGE_GOALS 1

#define MAX_EXPLORATION_GOALS 4

#define MAX_SCRIPTED_GOALS 8

#define MAX_PERIMETER_GOALS 2

// not implemented 12-10
#define MAX_RECON_GOAL_GOALS 2

#define MAX_RESOURCE_GOAL_GOALS 8

#define MAX_OTHER_GOAL_GOALS 3

#define MAX_ESCORT_GOAL_GOALS 5


///////////////////////////////////////////////////////////////////////////////
// New Construction Program stuff


///////////////////////////////////////////////////////////////////////////////
// The UCP Data
// --------------------
// This specifies what type of units to build.
UNIT_CONSTRUCTION_PROGRAM unit_construction_program[MAX_UCP_LENGTH];

#DATA

//   Which Account          BUDGET          BUDGET CAP
//----------------------------------------------------
	"Emergency",			20,				8;
	"Offense",				80,				UNLIMITED;

#END_DATA



///////////////////////////////////////////////////////////////////////////////
// ACCOUNT NOTES.
// --------------
// For each line item in an account, you must specify a build type from one of
// the following... NUMBER_TO_HAVE, NUMBER_TO_BUILD, RATIO_TO_BUILD, or RATIO_TO_HAVE.
//
// The "RATIO" items can only occur in the lowest priority level of an account.
// Also, all line-items with the same priority must have the same build type


///////////////////////////////////////////////////////////////////////////////
//EMERGENCY
// --------------------
// to make sure there is always money for scavengers

ACCOUNT Emergency[MAX_ACCOUNT_LENGTH];

#DATA

//  Priority     Item Name              Build Type              Build Amount
//--------------------------------------------------------------------
	16,		"avscav",		NUMBER_TO_HAVE,			2;

#END_DATA

///////////////////////////////////////////////////////////////////////////////
// OFFENSE
// --------------------
// What sort of offensive units and support structures do we want

ACCOUNT Offense[MAX_ACCOUNT_LENGTH];

#DATA

//  Priority     Item Name              Build Type              Build Amount
//--------------------------------------------------------------------
	10,		"avturr",		NUMBER_TO_BUILD,			4;
	9,		"avfigh",		NUMBER_TO_HAVE,			2;

	

#END_DATA




///////////////////////////////////////////////////////////////////////////////
// FORCE MATCHING
// --------------
// Which units do we want to emphasize & target with this aip?
// Note that this can be used for BOTH the AI team's unit strengths and 
// the opponents'
FORCE_MATCHING My_Matchings[MAX_FORCE_MATCHING];

#DATA

// Unit Name             Multiplier
//----------------------------------

   "svfigh",       	1.0;
   "svturr",		0.5;
   "svscav",       	0.2;
   "svtank",		2.0;
   "svltnk",		1.5;
   "svhraz",		1.5;
   "svwalk",		3.0;	
   "avfigh",       	0.5;
   "avturr",		1.0;
   "avscav",       	0.2;
   "avtank",		2.0;
   "avltnk",		1.5;
   "avwalk",		3.0;
   "avhraz",		1.5;

#END_DATA

//BUILDING_MATCHING My_Building_Matchings[MAX_BUILDINGS];

//#DATA

// Building Name                   Multiplier         Where to Build
//------------------------------------------------------------------
  "avmuf",                          2.00,             CENTER_OF_BASE;
  "avrecy",                         2.00,             CENTER_OF_BASE;

#END_DATA
