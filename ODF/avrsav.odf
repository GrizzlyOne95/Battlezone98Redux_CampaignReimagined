// Opt-in occupied rescue prototype. Spawn with CRSAVTest.SpawnPickup().
// SAVEnemy on a friendly team is experimental; this is not a SAVFriend implementation.
[GameObjectClass]
baseName = "avsav"
classLabel = "sav"
pilotCost = 1
pilotClass = "aspilo"
userClass = "asuser"
scrapValue = 5
scrapCost = 8
maxHealth = 3500
maxAmmo = 2000
unitName = "Fury - Pickup Test"
aiName = "SAVEnemy"
aiName2 = "SAVEnemy"
heatSignature = 0.5
imageSignature = 0.8
radarSignature = 1.0
weaponHard1 = "GC1"
weaponName1 = "gbolt"
weaponHard2 = "GR1"
weaponName2 = "gwasp"

[CraftClass]
