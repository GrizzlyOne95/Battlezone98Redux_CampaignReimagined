// ============================================================
// CR NSDF damage, LIGHT stage (dmgnsdf1)
// Look: thin cool-grey coolant vapour, cyan-white electrical shorts (sparks join from stage 2).
// Budget: ~30 live sprites (optimized dmgvhcl1 is ~40).
// ============================================================

[Dmgnsdf1]
renderBase = "draw_twirl_trail"
emitDelay = 0.06
emitDelayVar = 0.03
emitVelocity = "0.0 5.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.2 0.2 0.2"
emitLife = 1.8
textureName = "cr_xpl_wisp.dds"
startColor = "215 220 230 40"
finishColor = "215 220 230 0"
startRadius = 1.0
finishRadius = 2.4
animateTime = 1.8
rotationRate = 2.0
