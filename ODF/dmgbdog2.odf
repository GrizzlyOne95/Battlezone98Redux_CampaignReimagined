// ============================================================
// CR Black Dog damage, MEDIUM stage (dmgbdog2)
// Look: lean, fast, near-black column from the first stage; crimson sparks.
// Budget: ~43 live sprites (optimized dmgvhcl2 is ~60).
// ============================================================

[Dmgbdog2]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "dmgbdog2.smokeemitter"
renderName2 = "dmgbdog2.sparkemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.06
emitDelayVar = 0.03
emitVelocity = "0.0 7.0 0.0"
emitVariance = "1.2 1.2 1.2"
emitInherit = "0.2 0.2 0.2"
emitLife = 1.6
textureName = "smoke2.tga"
startColor = "65 62 64 48"
finishColor = "65 62 64 0"
startRadius = 0.7
finishRadius = 1.8
animateTime = 1.6
rotationRate = 3.0

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 4.0 0.0"
emitVariance = "5.0 5.0 5.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 0.8
textureName = "cr_xpl_spark.dds"
startColor = "255 120 100 255"
finishColor = "160 0 0 0"
startRadius = 0.2
finishRadius = 0.06
animateTime = 0.8
rotationRate = 20.0
