// ============================================================
// CR Black Dog death explosion, DETONATE stage (xdbdogd)
// Look: tight hot flash, crimson embers, fast near-black column.
// Budget: 9 particles (stock xcarxplb is 9), one light. Gameplay fields copied from xcarxplb.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
explRadius = 10.0
explSound = "xcar.wav"
damageRadius = 20.0
damageBallistic = 0
damageConcussion = 100
damageFlame = 0
damageImpact = 0

particleTypes = 6

particleClass1 = "xdbdogd.Flash"
particleCount1 = 1
particleVeloc1 = "0.00 0.00 0.00"

particleClass2 = "xdbdogd.Core"
particleCount2 = 1
particleVeloc2 = "0.00 1.00 0.00"
particleBias2 = "0.00 2.00 0.00"

particleClass3 = "xdbdogd.Debris"
particleCount3 = 2
particleVeloc3 = "6.00 6.00 6.00"
particleBias3 = "0.00 3.00 0.00"

particleClass4 = "xdbdogd.Ember"
particleCount4 = 2
particleVeloc4 = "5.00 4.00 5.00"
particleBias4 = "0.00 2.00 0.00"

particleClass5 = "xdbdogd.Smoke"
particleCount5 = 2
particleVeloc5 = "2.00 1.00 2.00"
particleBias5 = "0.00 1.00 0.00"

particleClass6 = "xdbdogd.Light"
particleCount6 = 1
particleVeloc6 = "0.00 2.00 0.00"
particleBias6 = "0.00 5.00 0.00"

[Flash]
simulateBase = "sim_null"
lifeTime = 0.30
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "255 200 180 255"
finishColor = "200 20 20 0"
startRadius = 6.40
finishRadius = 12.80
animateTime = 0.30

[Core]
