renderBase = "draw_twirl"
textureName = "cr_xpl_core.dds"
textureBlend = "one one modulate"
startColor = "255 130 110 255"
finishColor = "140 0 0 0"
startRadius = 3.20
finishRadius = 10.40
animateTime = 1.10
rotationRate = 3.00

[Debris]
