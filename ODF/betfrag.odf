// CCA Bouncing Betty shrapnel.
// 45 direct + 15 small splash; radial distribution keeps real single-target damage below aggregate output.
[OrdnanceClass]
classLabel = "bullet"

shotGeometry = NULL
shotSound = NULL
xplGround = "betfhit"
xplVehicle = "betfhit"
xplBuilding = "betfhit"
xplExpire = NULL

renderName = "betfrag.render"

ammoCost = 1
lifeSpan = 0.65
shotSpeed = 90.0
damageBallistic = 45
damageConcussion = 0
damageFlame = 0
damageImpact = 0

[Render]
renderBase = "draw_multi"
renderCount = 2
renderName1 = "betfrag.trail"
renderName2 = "betfrag.spark"

[Trail]
renderBase = "draw_trail"
textureName = "trail2.tga"
textureBlend = "one one modulate"
startColor = "255 205 80 220"
finishColor = "255 90 10 0"
startRadius = 0.10
finishRadius = 0.0
segmentTime = 0.08
textureRate = 0.45

[Spark]
renderBase = "draw_twirl"
textureName = "spark.tga"
textureBlend = "one one modulate"
startColor = "255 230 130 255"
finishColor = "255 80 10 0"
startRadius = 0.16
finishRadius = 0.05
rotationRate = 14.0
