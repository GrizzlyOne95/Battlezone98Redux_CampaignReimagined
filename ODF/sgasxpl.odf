// Wide CCA Siege Mortar blast.
// 250 concussion over 65 m versus stock Mortar blast's 200 over 50 m.
[ExplosionClass]
classLabel = "explosion"
explSound = "xmv1.wav"
damageRadius = 65.0
damageBallistic = 0
damageConcussion = 250
damageFlame = 0
damageImpact = 0

particleTypes = 4

particleClass1 = "sgasxpl.light"
particleCount1 = 1
particleVeloc1 = "0.0 2.0 0.0"
particleBias1 = "0.0 4.0 0.0"

particleClass2 = "sgasxpl.smoke"
particleCount2 = 1
particleVeloc2 = "0.0 5.0 0.0"
particleBias2 = "0.0 8.0 0.0"

particleClass3 = "sgasxpl.flame"
particleCount3 = 1
particleVeloc3 = "0.0 2.0 0.0"
particleBias3 = "0.0 4.0 0.0"

particleClass4 = "sgasxpl.sphere"
particleCount4 = 1
particleVeloc4 = "0.0 0.0 0.0"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.75
renderBase = "draw_light"
startColor = "255 220 90 500"
finishColor = "255 120 20 0"
startRadius = 65.0
finishRadius = 45.0
animateTime = 0.75
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0

[Smoke]
simulateBase = "sim_smoke"
lifeTime = 2.6
renderBase = "draw_twirl"
textureName = "smoke2.tga"
startColor = "105 95 85 150"
finishColor = "75 70 65 0"
startRadius = 10.0
finishRadius = 20.0
animateTime = 2.6
rotationRate = 8.0

[Flame]
simulateBase = "sim_smoke"
lifeTime = 0.8
renderBase = "draw_twirl"
textureName = "flame.tga"
textureBlend = "one one modulate"
startColor = "255 230 130 255"
finishColor = "255 120 20 0"
startRadius = 7.0
finishRadius = 14.0
animateTime = 0.8
rotationRate = 8.0

[Sphere]
simulateBase = "sim_null"
lifeTime = 0.40
renderBase = "draw_sphere"
textureName = "vsmoke.tga"
startColor = "255 220 150 45"
finishColor = "80 70 60 0"
startRadius = 10.0
finishRadius = 65.0
animateTime = 0.40
latitudeBands = 16
longitudeSegments = 32
InitialPitch = 0.0
InitialYaw = 0.0
InitialRoll = 0.0
AddPitch = 10.0
AddYaw = 10.0
AddRoll = 10.0
