[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored minigun: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_minigun.mesh"
flashMaterial = "CR/Muzzle/minigun"
flashDuration = 0.045
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Ballistic small brass; local cosmetic only.
casingType = "small"
// Optional custom ejected-brass mesh (OpenShim exact-GOG ODF scope; ShellCasings ON):
// casingMesh = "mymod_brass.mesh"
// Uncomment above after shipping that Ogre .mesh and its materials/textures in the mod.
// Use a rigid case centred at 0, unit length 1 along local +Z, base -0.5 / mouth +0.5.
// casingType scales the whole mesh: small 0.12, medium 0.24, large 0.40; none disables.
// Missing/empty casingMesh tries gminigun_casing.mesh, then the generated default.
// An explicit missing/invalid casingMesh suppresses the casing; names are case-sensitive.
// Existing per-weapon mesh materials are used; this does not change flashMesh.
// For CR regeneration, set this weapon casing_mesh in References/WeaponPresentation/profiles.json.
// CR WEAPON CASING END
classLabel = "machinegun"
ordName = "bullet1"
wpnName = "Minigun"
fireSound = "gmini00.wav"
wpnReticle = "gminigun"
wpnPriority = 0
wpnCategory = "CANN"

[CannonClass]
shotDelay = 0.20

