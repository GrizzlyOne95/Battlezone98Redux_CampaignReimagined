// NSDF Laser-Guided Missile.
// Targeting-gun pattern proven by Resurgence; requires the player to keep the designator on target.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored rocket: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_rocket.mesh"
flashMaterial = "CR/Muzzle/rocket"
flashDuration = 0.1
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Energy, launcher, explosive or utility: no ejected brass.
casingType = "none"
// CR WEAPON CASING END
classLabel = "targeting"
ordName = "lgmissl"
wpnName = "Laser-Guided Missile"
fireSound = "gtagg00.wav"
wpnReticle = "gtaggun.0"
wpnCategory = "ROCK"
wpnPriority = 3

[TargetingGunClass]
leaderSound = "gtagg03.wav"
shotDelay = 1.50
firstDelay = 0.0
salvoDelay = 0.0
shotVariance = 0.0
salvoCount = 1
lockingReticle = "gtaggun.1"
lockedReticle = "gtaggun.2"

[OrdnanceClass]
classLabel = "targeting"
