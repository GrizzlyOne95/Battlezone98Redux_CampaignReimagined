[ExplosionCore]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "xminxpl.scorch"
renderName2 = "xminxpl.light"
renderName3 = "xminxpl.smokecenter"
renderName4 = "xminxpl.flamecenter"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.8
renderBase = "draw_light"
startColor = "255 255 63 1000"
finishColor = "255 255 255 0"
startRadius = 100.0
finishRadius = 100.0
animateTime = 0.8
attenuateConstant = 0.0
attenuateLinear = 1.0
attenuateQuadratic = 0.0

[Scorch]
simulateBase = "sim_null"
lifeTime = 10.0
renderBase = "draw_planar"
textureName = "cr_fx_scorch.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "0 0 0 192"
finishColor = "0 0 0 0"
startRadius = 20.0
finishRadius = 20.0
animateTime = 10.0

[smokeemit]
simulateBase = "sim_dust"
lifeTime = 5.0
renderBase = "draw_twirl"
textureName = "smoke2.tga"
//textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "127 127 127 255"
finishColor = "127 127 127 0"
startRadius = 5.0
finishRadius = 10.0
animateTime = 5.0
rotationRate = 20
useTerrainColor = true
maxCount = 256

[smokecenter]
simulateBase = "sim_smoke"
