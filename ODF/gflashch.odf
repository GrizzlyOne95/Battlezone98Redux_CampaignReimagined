[WeaponClass] // Special 150 range version for TRO SP Guntowers. -GBD
// CR WEAPON FLASH BEGIN
// Authored arcred: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_arcred.mesh"
flashMaterial = "CR/Muzzle/arcred"
flashDuration = 0.055
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
// CR WEAPON CASING BEGIN
// Energy, launcher, explosive or utility: no ejected brass.
casingType = "none"
// CR WEAPON CASING END
// CR WEAPON RECOIL BEGIN
// Opt-in recoil: the craft supplies the node/distance/return, this weapon supplies the kick.
// A craft's recoilKick<N> overrides it (e.g. 0.15 for a scout's miniguns). Machineguns get none.
recoilKick = 1.0
// CR WEAPON RECOIL END
classLabel = "beamgun"
ordName = "flashch"
wpnName = "Flash Cannon"
fireSound = "gflas00.wav"
wpnReticle = "gflashgn"
wpnPriority = 6
wpnCategory = "CANN"
