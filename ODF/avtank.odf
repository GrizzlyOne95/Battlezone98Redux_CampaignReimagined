[GameObjectClass]
classLabel = "wingman"
scrapValue = 5
scrapCost = 8
buildTime = 10.0
maxHealth = 3000
maxAmmo = 1200
weaponMask = 00001
unitName = "Tank"
aiName = "RocketTankFriend"
aiName2 = "RocketTankEnemy"
retargetPeriodAI = 0.5
heatSignature = 1.2
imageSignature = 3.0
radarSignature = 0.2
weaponHard1 = "GC1"
weaponName1 = "gatstab"
weaponHard2 = "GC2"
weaponName2 = "gminigun"
weaponHard3 = "GS1"
weaponName3 = "gquake"
weaponHard4 = "GM1"
weaponName4 = "gmdmgun"

[CraftClass]
// CR CRAFT FLASH OFFSET BEGIN
// Visible barrel tip from the hardpoint (right up forward, metres); replaces the
// weapon's flashOffset for this craft. Regenerate: Tools/Build-WeaponFlashes.py --measure
flashOffset1 = "0.20 0.10 2.41"
// CR CRAFT FLASH OFFSET END
// OpenShim muzzle presentation authoring reference (examples stay commented).
// Experimental exact-GOG 2.2.301 / single-player cannon path, not MP support.
// Settings > Video > Muzzle Recoil is the master switch: OFF by default,
// restart required. Enabling it still needs these ODF keys and matching art.
// Slot 1 (cannon) has this node slide enabled; with the switch OFF nothing
// moves. Old trial environment flags cannot bypass an OFF setting.
//
// Slot 1 currently uses STOCK gatstab above. Recoil belongs here on the craft;
// flash/smoke/light belong in the WEAPON's [WeaponClass], not this section.
// See the commented references in gatstaba.odf and gatstabh.odf; neither local
// variant is selected by this avtank unless weaponName1 is changed explicitly.
//
// Option A (ACTIVE below, slot 1): slide the stock world barrel's native model node (case-sensitive,
// at most 8 characters). This is not an arbitrary Ogre bone or clip name.
// Distance is metres; return is metres/second, along negative local forward.
recoilName1 = "AGR11BGA"
recoilDistance1 = 0.30
recoilReturn1 = 2.5
//
// Option B (alternative, commented): play a clip AUTHORED into the mesh/skeleton. Stock avtank does not
// supply osh_recoil; author/install it before selecting this alternative.
// Needs matching EXU loaded by the mission (require("exu")). The same named
// cockpit clip is optional. A present animation key takes priority over the
// node slide; an unavailable clip does not fall back to sliding the node.
// recoilAnimation1 = "osh_recoil"
// recoilPlaybackRate1 = 1.0
// recoilCockpit1 = true
//
// Suffixes 1..5 identify weapon slots; adapt the node/clip for each model.
// Disable an existing Lua recoil producer before giving ODF control ownership.
// Node slides need OpenShim only; authored clips additionally need EXU.
// Upstream setup/status: OpenShim Docs/ODF_RECOIL_TRIAL.md, PR #513:
// https://github.com/GrizzlyOne95/Battlezone98Redux_Shim/pull/513
rangeScan = 459.99999999999994
periodScan = 5.0f
velocJam = 5.0f
selectWaitMsg = "avtankv0.wav"
selectAttackMsg = "avtankvj.wav"
selectFollowMsg = "avtankvn.wav"
selectGoMsg = "avtankvm.wav"
selectOtherMsg = "avtankvp.wav"
goMsg = "avtankv1.wav"
attackMsg = "avtankv2.wav"
followMeMsg = "avtankv4.wav"
followMsg = "avtankvk.wav"
repairMsg = "avtankv8.wav"
reloadMsg = "avtankv9.wav"
rescueMsg = "avtankvc.wav"
recycleMsg = "avtankvd.wav"
otherMsg = "avtankvn.wav"
user1Msg = "avtankva.wav"
killedMsg = "avtankv3.wav"
diedMsg = "abetty3.wav"

[HoverCraftClass]
setAltitude = 1.0
accelDragStop = 4.0
accelDragFull = 1.0
alphaTrack = 20.0
alphaDamp = 5.0
pitchPitch = 0.25
pitchThrust = 0.1
rollStrafe = 0.1
rollSteer = 0.1
velocForward = 22.5
velocReverse = 22.5
velocStrafe = 22.5
accelThrust = 20.25
accelBrake = 75.0
omegaSpin = 3.5
omegaTurn = 1.5
alphaSteer = 5.0
accelJump = 24.0
soundThrust = "avtanke0.wav"
soundTurbo = "avtanke3.wav"

