// CCA Hunter Rocket.
// Cannon-fired thermal ordnance: no launcher lock cycle, but only weak heat correction.
[WeaponClass]
// CR WEAPON FLASH BEGIN
// Authored rocket: shape/colour/timing in References/WeaponPresentation/profiles.json.
// Requires Muzzle Flashes ON and matching EXU; native SP/build guards remain.
flashMesh = "crmf_rocket.mesh"
flashMaterial = "CR/Muzzle/rocket"
flashDuration = 0.1
flashScale = 1
flashEndScale = 0.65
flashOffset = "0 0 0"
// CR WEAPON FLASH END
classLabel = "cannon"
ordName = "shunter"
wpnName = "CCA Hunter Rocket"
fireSound = "gmasg00.wav"
wpnReticle = "ghornet.0"
wpnPriority = 0
wpnCategory = "ROCK"

[CannonClass]
shotDelay = 1.50
shotVariance = 0.008
