// ============================================================
// CR NSDF death explosion, SECONDARY stage (xdnsdfs)
// Look: cool white-blue flash, cyan-white electrical sparks, grey coolant vapour.
// Budget: 4 particles (stock xsecxpla is 5). Gameplay fields copied from xsecxpla.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
explRadius = 3.0
explSound = NULL
damageRadius = 3.0
damageBallistic = 0
damageConcussion = 25
damageFlame = 0
damageImpact = 0

particleTypes = 3

particleClass1 = "xdnsdfs.Debris"
particleCount1 = 2
particleVeloc1 = "3.00 3.00 3.00"
particleBias1 = "0.00 1.00 0.00"

particleClass2 = "xdnsdfs.Smoke"
particleCount2 = 1
particleVeloc2 = "1.00 0.60 1.00"
particleBias2 = "0.00 0.50 0.00"

particleClass3 = "xdnsdfs.Flash"
particleCount3 = 1
particleVeloc3 = "0.00 0.00 0.00"

[Debris]
simulateBase = "sim_ember"
lifeTime = 2.00
renderBase = "draw_twirl"
textureName = "cr_xpl_debris.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "200 210 225 255"
finishColor = "100 110 125 0"
startRadius = 0.50
finishRadius = 0.50
animateTime = 2.00
rotationRate = 6.00

[Smoke]
simulateBase = "sim_smoke"
lifeTime = 1.60
renderBase = "draw_twirl"
textureName = "cr_xpl_wisp.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
startColor = "175 180 190 200"
finishColor = "90 92 100 0"
startRadius = 0.80
finishRadius = 2.20
animateTime = 1.60
rotationRate = 3.00

[Flash]
simulateBase = "sim_null"
lifeTime = 0.18
renderBase = "draw_sprite"
textureName = "cr_xpl_flash.dds"
textureBlend = "one one modulate"
startColor = "235 245 255 255"
finishColor = "90 170 255 0"
startRadius = 1.60
finishRadius = 3.20
animateTime = 0.18
