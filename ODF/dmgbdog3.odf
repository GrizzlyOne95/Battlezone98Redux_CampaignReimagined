// ============================================================
// CR Black Dog damage, HEAVY stage (dmgbdog3)
// Look: lean, fast, near-black column from the first stage; crimson sparks.
// Budget: ~64 live sprites + one flicker light (optimized dmgvhcl3 is ~74).
// ============================================================

[Dmgbdog3]
renderBase = "draw_multi"
renderCount = 4
renderName1 = "dmgbdog3.smokeemitter"
renderName2 = "dmgbdog3.flameemitter"
renderName3 = "dmgbdog3.sparkemitter"
renderName4 = "dmgbdog3.lightemitter"

[SmokeEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.03
emitVelocity = "0.0 7.0 0.0"
emitVariance = "1.2 1.2 1.2"
emitInherit = "0.2 0.2 0.2"
emitLife = 1.8
textureName = "cr_xpl_smoke.dds"
startColor = "30 26 28 72"
finishColor = "30 26 28 0"
startRadius = 0.8
finishRadius = 2.0
animateTime = 1.8
rotationRate = 3.0

[FlameEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 7.0 0.0"
emitVariance = "2.0 2.0 2.0"
emitInherit = "0.3 0.3 0.3"
emitLife = 0.6
textureName = "flame2.tga"
startColor = "255 200 180 140"
finishColor = "200 0 0 0"
startRadius = 0.5
finishRadius = 0.1
animateTime = 0.6
rotationRate = 10.0

[SparkEmitter]
renderBase = "draw_twirl_trail"
emitDelay = 0.05
emitDelayVar = 0.02
emitVelocity = "0.0 4.0 0.0"
emitVariance = "5.0 5.0 5.0"
emitInherit = "0.5 0.5 0.5"
emitLife = 0.8
textureName = "cr_xpl_spark.dds"
startColor = "255 120 100 255"
finishColor = "160 0 0 0"
startRadius = 0.2
finishRadius = 0.06
animateTime = 0.8
rotationRate = 20.0

[LightEmitter]
renderBase = "draw_emit"
emitName = "dmgbdog3.light"
emitDelay = 0.2
emitDelayVar = 0.1
emitVelocity = "0 0 0"
emitVariance = "0.0 0.0 0.0"
emitInherit = "1.0 1.0 1.0"

[Light]
simulateBase = "sim_smoke"
lifeTime = 0.2
renderBase = "draw_light"
startColor = "255 110 90 160"
finishColor = "255 80 60 110"
startRadius = 6.0
finishRadius = 4.5
animateTime = 0.2
attenuateConstant = 0.0
attenuateLinear = 0.0
attenuateQuadratic = 1.0
lensFlare = false
