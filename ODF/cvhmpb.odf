weaponName3 = ""
weaponHard4 = "GS1"
weaponName4 = ""

[CraftClass]
// CR CRAFT FLASH OFFSET BEGIN
// Flash point from the hardpoint (right up forward, metres: barrel tip, or 0 0 0 at
// a muzzle-face hardpoint); replaces the weapon's flashOffset for this craft.
// Regenerate: Tools/Build-WeaponFlashes.py --measure
flashOffset1 = "0.04 -0.01 0.02"
flashOffset2 = "-0.03 -0.01 0.02"
// CR CRAFT FLASH OFFSET END
// CR CRAFT RECOIL BEGIN
// Reviewed independent gun pieces; preserve aiming and deployment parents.
// Regenerate: python Tools/Build-CombatPresentation.py
recoilAnimation1 = "cr_fire_1"
recoilPlaybackRate1 = 1.0
recoilCockpit1 = true
casingOffset1 = "0.5185 0.2015 -0.2778"
casingDirection1 = "0.9345 0.3271 -0.1402"
recoilAnimation2 = "cr_fire_2"
recoilPlaybackRate2 = 1.0
recoilCockpit2 = true
casingOffset2 = "-0.5109 0.1988 -0.2766"
casingDirection2 = "-0.9345 0.3271 -0.1402"
// CR CRAFT RECOIL END
rangeScan = 360.0
periodScan = 5.0f
velocJam = 5.0f
selectWaitMsg = "avtankv0.wav"
selectAttackMsg = "avtankvj.wav"
selectFollowMsg = "avtankvn.wav"
selectGoMsg = "avtankvm.wav"
selectOtherMsg = "avtankvp.wav"
goMsg = "avtankv1.wav"
attackMsg = "avtankv2.wav"
followMeMsg = "avtankv4.wav"
followMsg = "avtankvk.wav"
repairMsg = "avtankv8.wav"
reloadMsg = "avtankv9.wav"
rescueMsg = "avtankvc.wav"
recycleMsg = "avtankvd.wav"
otherMsg = "avtankvn.wav"
user1Msg = "avtankva.wav"
killedMsg = "avtankv3.wav"
diedMsg = "abetty3.wav"
cloakAllowed = "True"
// CR DAMAGE FX BEGIN
// CRA damage smoke (ODF/dmgcra1-4.odf)
damageEffect1 = "dmgcra1"
damageEffect2 = "dmgcra2"
damageEffect3 = "dmgcra3"
damageEffect4 = "dmgcra4"
// CR DAMAGE FX END

[HoverCraftClass]
setAltitude = 1.5
accelDragStop = 4.0
accelDragFull = 1.0
alphaTrack = 20.0
alphaDamp = 5.0
pitchPitch = 0.25
pitchThrust = 0.1
rollStrafe = 0.1
rollSteer = 0.1
velocForward = 20.0
velocReverse = 14.0
velocStrafe = 14.0
accelThrust = 10.0
accelBrake = 5.0
omegaSpin = 1.875
omegaTurn = 1.875
alphaSteer = 3.75
accelJump = 0.0
soundThrust = "avtanke0.wav"
soundTurbo = "avtanke3.wav"
// wing pods CEM11WGL/WGR are class 67 nacelles (cvhtnk.vdf) carrying BDA-parented hardpoints: zero gain keeps them flat
pitchThrotNacelleRun = 0
pitchThrotNacelleJump = 0
pitchSteerNacelleRun = 0
pitchSteerNacelleJump = 0

