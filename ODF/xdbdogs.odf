// ============================================================
// CR Black Dog death explosion, SECONDARY stage (xdbdogs)
// Look: tight hot flash, crimson embers, fast near-black column.
// Budget: 4 particles (stock xsecxpla is 5). Gameplay fields copied from xsecxpla.
// ============================================================

[ExplosionClass]
classLabel = "explosion"
explRadius = 3.0
explSound = NULL
damageRadius = 3.0
damageBallistic = 0
damageConcussion = 25
damageFlame = 0
damageImpact = 0

particleTypes = 3

particleClass1 = "xdbdogs.Debris"
particleCount1 = 2
particleVeloc1 = "3.00 3.00 3.00"
particleBias1 = "0.00 1.00 0.00"

particleClass2 = "xdbdogs.Smoke"
particleCount2 = 1
particleVeloc2 = "1.00 0.60 1.00"
particleBias2 = "0.00 0.50 0.00"

particleClass3 = "xdbdogs.Flash"
particleCount3 = 1
particleVeloc3 = "0.00 0.00 0.00"

[Debris]
simulateBase = "sim_ember"
lifeTime = 2.00
renderBase = "draw_twirl"
textureName = "cr_xpl_debris.dds"
textureBlend = "srcalpha invsrcalpha modulatealpha"
