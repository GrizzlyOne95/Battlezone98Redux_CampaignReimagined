// Escape from Mars orbital insert (CR06OrbitFilm.lua). Peer-local presentation.
// CCA destroyer fire: three guns per system; the script aims each emitter and
// sets its lifetime so bolts expire at the Lincoln's hull.
particle_system CR/M06O/Bolt
{
    material CR06/HotCore
    particle_width 2.2
    particle_height 34
    quota 120
    cull_each false
    sorted false
    local_space false
    billboard_type oriented_self
    emitter Point
    {
        angle 0.6
        emission_rate 0
        time_to_live 1
        direction 0 0 1
        velocity 650
        colour 1 0.45 0.25 1
    }
    emitter Point
    {
        angle 0.6
        emission_rate 0
        time_to_live 1
        direction 0 0 1
        velocity 650
        colour 1 0.45 0.25 1
    }
    emitter Point
    {
        angle 0.6
        emission_rate 0
        time_to_live 1
        direction 0 0 1
        velocity 650
        colour 1 0.45 0.25 1
    }
}
// Hull impact fireball: one burst, then the system is destroyed by the script.
particle_system CR/M06O/Blast
{
    material CR06/Exhaust
    particle_width 7
    particle_height 7
    quota 40
    cull_each false
    sorted false
    local_space false
    billboard_type point
    emitter Point
    {
        angle 180
        emission_rate 260
        duration 0.12
        time_to_live_min 0.35
        time_to_live_max 0.7
        velocity_min 4
        velocity_max 18
        colour_range_start 1 0.85 0.5 1
        colour_range_end 1 0.45 0.15 1
    }
    affector Scaler
    {
        rate 12
    }
    // Additive material: alpha is ignored, so fade the colour itself to black.
    affector ColourFader
    {
        red -1.5
        green -1.6
        blue -1.0
    }
}
