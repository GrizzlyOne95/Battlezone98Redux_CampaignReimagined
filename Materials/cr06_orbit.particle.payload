particle_system CR/M06O/Vent
{
    material CR_FX/SmokeThin
    particle_width 12
    particle_height 12
    quota 220
    cull_each false
    sorted true
    local_space false
    billboard_type point
    emitter Point
    {
        angle 40
        emission_rate 45
        direction 1 0.3 0
        time_to_live_min 3
        time_to_live_max 5
        velocity_min 4
        velocity_max 10
        colour_range_start 0.35 0.33 0.32 0.55
        colour_range_end 0.5 0.48 0.46 0.35
    }
    affector Scaler
