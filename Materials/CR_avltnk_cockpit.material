import * from "CR_BZBase.material"

material CRV/avltnkOriginalFrame : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap avltnk_D.dds
    set_texture_alias NormalMap avltnk_N.dds
    set_texture_alias SpecularMap avltnk_S.dds
    set_texture_alias EmissiveMap avltnk_E.dds
}

material CRV/avltnkHullPaint : CR_BZBase
{
    set_texture_alias DiffuseMap crvascp_d.dds
    set_texture_alias NormalMap crvascp_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvascp_e.dds
}
