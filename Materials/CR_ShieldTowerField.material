// Shield tower push-field box (CRShieldTowerFX): additive hex-lattice shield on a
// scaled unit cube (cube_10x10x10.mesh, UVs 0..1 per face), fixed-function only.
// Single pass, 2 plain-modulate units: OpenShim's DX11 compat path
// (dx11_legacy_material_compat.cpp, IsSupportedTwoStageCombo) suppresses multi-pass
// techniques and colour_op_ex src_manual. So the lattice textures are pre-tinted RGB
// (Tools/shield_tower_field/make_textures.py) and the band texture has a baked floor.
// Ogre scale is inverse (0.5 doubles the texture), so 0.1 x 0.0866
// repeats the tile 10 x 11.55 per face: the tile holds 2 hexes across and its v axis
// is stretched 1/0.866, so v repeats 1.155x u to keep hexes regular.
// Drawn only while the tower is powered.

material CR_ShieldTowerField_Green
{
	technique
	{
		pass
		{
			lighting off
			scene_blend add
			depth_write off
			cull_hardware none
			cull_software none
			fog_override true
			// Pre-tinted lattice.
			texture_unit
			{
				texture cr_shieldfield_hex_green.dds
				scale 0.1 0.0866
				colour_op modulate
			}
			// Band (with baked floor) scrolling up = shimmer sweeping up the box.
			texture_unit
			{
				texture cr_shieldfield_band.dds
				scroll_anim 0 -0.08
				colour_op modulate
			}
		}
	}
}
