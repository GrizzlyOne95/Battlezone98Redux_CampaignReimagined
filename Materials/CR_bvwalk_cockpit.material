import * from "CR_BZBase.material"

material CRV/bvwalkGunArms : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap bvwalk_D.dds
    set_texture_alias NormalMap bvwalk_N.dds
    set_texture_alias SpecularMap bvwalk_S.dds
    set_texture_alias EmissiveMap bvwalk_E.dds
}

material CRV/bvwalkJointBacks : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap crvbscp_d.dds
    set_texture_alias NormalMap crvbscp_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvbscp_e.dds
}
