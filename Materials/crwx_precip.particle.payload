// Generated by tools/precipgen.py -- edit the generator, not this file.
//
// Campaign Reimagined weather (ported from the ISDF Chronicles weather stack) as Ogre ParticleFX, driven by CRPrecip.lua through
// Extra Utilities. Each system is attached to the camera: the emitter volume
// travels with the view while the particles it has emitted stay in world
// space, so rain does not slide when the player turns. CRPrecip.lua sets the
// emission rate (intensity), the LinearForce (wind) and, for grit, the emitter
// direction; the numbers here are the full-intensity shape.
//
// Index map, every system: emitter 0 = the volume, affector 0 = LinearForce.
// Append emitters and affectors, never insert: CRPrecip.lua uses the indices.
// Distances are metres. Short lifetimes are what make the rates affordable:
// the volume only has to cover what the fog lets the player see.

// Rain: streaks aligned to their own velocity, so wind slants them.
particle_system CRWX/Rain
{
    material            CRWX_FX/Rain
    particle_width      0.22
    particle_height     3.2
    quota               5200
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      oriented_self

    emitter Box
    {
        angle               4
        emission_rate       1650
        time_to_live_min    0.8
        time_to_live_max    1.25
        direction           0 -1 0
        velocity_min        58
        velocity_max        80
        colour_range_start  0.74 0.80 0.86 0.50
        colour_range_end    0.60 0.68 0.76 0.28
        width               180
        height              80
        depth               180
    }

    affector LinearForce
    {
        force_vector        0 0 0
        force_application   add
    }
}

