import * from "CR_BZBase.material"

material CRV/NSDFScoutCockpit : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap crvascp_d.dds
    set_texture_alias NormalMap crvascp_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvascp_e.dds
}

material CRV/NSDFScoutNose : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap avfigh_D.dds
    set_texture_alias NormalMap avfigh_N.dds
    set_texture_alias SpecularMap avfigh_S.dds
    set_texture_alias EmissiveMap avfigh_E.dds
}
