import * from "CR_BZBase.material"

material crstbd : CR_BZBase
{
    set_texture_alias DiffuseMap crstbd_d.dds
    set_texture_alias NormalMap crvstor_n.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crstbd_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}
