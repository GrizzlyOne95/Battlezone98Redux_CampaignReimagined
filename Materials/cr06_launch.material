import * from "sprites.material"
// Hue belongs in the material: neutral particle RGB avoids renderer channel swizzles.
material CR06/HotCore : BZSprite/Additive
{
    set_texture_alias DiffuseMap blast.png
    technique 0
    {
        pass 0
        {
            diffuse 1 0.92 0.72 1
        }
    }
    technique glow
    {
        pass 0
        {
            diffuse 0.7 0.55 0.3 1
        }
    }
}
material CR06/Exhaust : BZSprite/Additive
{
    set_texture_alias DiffuseMap blast.png
    technique 0
    {
        pass 0
        {
            diffuse 1 0.62 0.14 1
        }
    }
    technique glow
    {
        pass 0
        {
            diffuse 0.8 0.44 0.08 1
        }
    }
}
