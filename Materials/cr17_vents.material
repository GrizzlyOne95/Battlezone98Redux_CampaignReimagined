import * from "sprites.material"

// Mission 17 core vents (CRJungle17). The hue lives in the material, after the
// sprite shader's vertex-colour swizzle (SM4/GLSL read BGRA, SM3 does not), so
// the neutral emitter RGB in cr17_jungle.particle.payload stays fire-coloured
// on every backend. Same pattern as CR16/FuryExhaust.
material CR17/VentFlame : BZSprite/Additive
{
	set_texture_alias DiffuseMap blast.png
	technique 0
	{
		pass 0
		{
			diffuse 1 0.62 0.2 1
		}
	}
	technique glow
	{
		pass 0
		{
			diffuse 0.5 0.31 0.1 1
		}
	}
}

material CR17/VentLick : BZSprite/Additive
{
	set_texture_alias DiffuseMap blast.png
	technique 0
	{
		pass 0
		{
			diffuse 0.95 0.26 0.05 1
		}
	}
	technique glow
	{
		pass 0
		{
			diffuse 0.48 0.13 0.03 1
		}
	}
}

