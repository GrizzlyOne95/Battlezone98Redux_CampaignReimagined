// Jupiter and the Galilean moons over the Io and Europa maps, each lit from
// the TRN sun with its true phase. Missions/misn10.trn and misn11.trn (Io) and
// misn12.trn and misn13.trn (Europa) name them in [Stars];
// Scripts/CRWorldArt.lua turns them with the world's orbit. Shaders:
// Shaders/CR_jovian.hlsl. Technique 1 draws nothing (OpenGL has no delegate).
// Sources and credits: Docs/SKY_ART_CREDITS.md.

material CRJOVIAN.MAP
{
	technique 0
	{
		pass 0
		{
			vertex_program_ref CR_Jovian_vertex
			{
			}
			fragment_program_ref CR_Jovian_fragment
			{
			}
			cull_hardware none
			cull_software none
			lighting off
			fog_override true none
			scene_blend alpha_blend
			depth_write off
			texture_unit 0
			{
				texture crsky_jupiter.png
				tex_address_mode wrap clamp
				filtering trilinear
			}
		}
	}
	technique 1
	{
		pass 0
		{
			vertex_program_ref Sky_vertex
			{
			}
			fragment_program_ref Sky_fragment
			{
			}
			lighting off
			fog_override true none
			scene_blend zero one
			depth_write off
			colour_write off
		}
	}
}

// The moons: airless ice and rock, so a flatter limb (Minnaert 0.6), no haze
// and no eclipse ring.
material CRIO.MAP : CRJOVIAN.MAP
{
	technique 0
	{
		pass 0
		{
			fragment_program_ref CR_Jovian_fragment
			{
				param_named bodyLook float4 0.43 0.05 1.2 0.02
				param_named bodySpin float4 0 0 0.6 0
				param_named bodyRing float4 0 0 0 0.01
			}
			texture_unit 0
			{
				texture crsky_io.png
			}
		}
	}
}

material CREUROPA.MAP : CRJOVIAN.MAP
{
	technique 0
	{
		pass 0
		{
			fragment_program_ref CR_Jovian_fragment
			{
				param_named bodyLook float4 0.43 0.05 1.2 0.02
				param_named bodySpin float4 0 0 0.6 0
				param_named bodyRing float4 0 0 0 0.01
			}
			texture_unit 0
			{
				texture crsky_europa.png
			}
		}
	}
}

