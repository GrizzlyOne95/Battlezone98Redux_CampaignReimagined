// =============================================================================
// Ash
// =============================================================================

particle_system CR/Weather/AshFall
{
    material            CR_FX/Ash
    particle_width      1.1
    particle_height     1.1
    quota               2000
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               28
        emission_rate       130
        time_to_live_min    6
        time_to_live_max    9
        direction           -0.35 -0.9 0.26
        velocity_min        5
        velocity_max        11
        colour_range_start  0.24 0.22 0.21 0.80
        colour_range_end    0.16 0.15 0.15 0.45
        width               240
        height              80
        depth               240
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }
}

// Embers are near-field only and deliberately few: they exist so a hot zone
// reads as hot, not to light the scene.
particle_system CR/Weather/AshEmber
{
    material            CR_FX/Ember
    particle_width      0.5
    particle_height     0.5
    quota               220
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               55
        emission_rate       9
        time_to_live_min    2.5
        time_to_live_max    5.0
        direction           0 -1 0
        velocity_min        2
        velocity_max        6
        colour_range_start  1.00 0.55 0.18 0.95
        colour_range_end    0.65 0.16 0.04 0.60
        width               70
        height              22
        depth               70
    }

    affector ColourFader
    {
        red     -0.20
        green   -0.28
        blue    -0.10
        alpha   -0.30
    }
}

// =============================================================================
// Alien
// =============================================================================

// Fury weather is not rain with a different palette: the motes hang, drift in
// no consistent direction, and glow on their own.
particle_system CR/Weather/Spore
{
    material            CR_FX/Spore
    particle_width      1.3
    particle_height     1.3
    quota               1200
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               75
        emission_rate       70
        time_to_live_min    8
        time_to_live_max    14
        direction           0 -0.3 0
        velocity_min        2
        velocity_max        6
        colour_range_start  0.32 0.90 0.95 0.90
        colour_range_end    0.52 0.30 0.90 0.55
        width               200
        height              90
        depth               200
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 0.32 0.90 0.95 0.00
        time1   0.25
        colour1 0.32 0.90 0.95 0.90
        time2   0.75
        colour2 0.52 0.40 0.95 0.70
        time3   1
        colour3 0.52 0.30 0.90 0.00
    }

    affector DirectionRandomiser
    {
        randomness      4
        scope           0.8
        keep_velocity   false
    }
}

// =============================================================================
// Rain
// =============================================================================

particle_system CR/Weather/Rain
{
    material            CR_FX/Rain
    particle_width      0.25
    particle_height     3.2
    quota               4000
    cull_each           true
    sorted              false
    local_space         false
    // Oriented along the fall direction so streaks read as streaks rather than
    // as a cloud of vertical sticks when the player looks up.
    billboard_type      oriented_common
    common_direction    0 -1 0

    emitter Box
    {
        angle               8
        emission_rate       420
        time_to_live_min    1.4
        time_to_live_max    2.2
        direction           0.32 -0.93 -0.18
        velocity_min        46
        velocity_max        62
        colour_range_start  0.66 0.78 0.38 0.55
        colour_range_end    0.52 0.64 0.28 0.30
        width               170
        height              70
        depth               170
    }
}

// A small bounded splash pool close to the camera. The design note is explicit:
// we do not try to generate a splash per raindrop.
particle_system CR/Weather/RainSplash
{
    material            CR_FX/RainSplash
    particle_width      0.5
    particle_height     0.5
    quota               300
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      perpendicular_common
    common_direction    0 1 0
    common_up_vector    0 0 1

    emitter Box
    {
        angle               180
        emission_rate       55
        time_to_live_min    0.25
        time_to_live_max    0.45
        direction           0 1 0
        velocity_min        1
        velocity_max        3
        colour_range_start  0.70 0.82 0.45 0.55
        colour_range_end    0.70 0.82 0.45 0.00
        width               42
        height              0.5
        depth               42
    }

    affector Scaler
    {
        rate 5
    }

    affector ColourFader
    {
        alpha -2.0
    }
}
