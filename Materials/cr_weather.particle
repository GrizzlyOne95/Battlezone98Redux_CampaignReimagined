// cr_weather.particle
//
// Ogre particle templates for the Campaign Reimagined weather controller.
//
// Every one of these is a camera-centred volume, not a map-wide simulation:
// CRWeather attaches the system to the camera's scene node, so the emitter box
// travels with the player while the particles it has already produced stay in
// world space. Sizing the box for the visible near field is what keeps a full
// storm affordable.
//
// Emitter ORDER MATTERS. CRWeatherPresets.lua addresses emitters by index, and
// index 0 is the emitter declared first in each block. Adding an emitter above
// an existing one silently retargets the preset's tuning.
//
// The values here are the authored baseline. Rate, velocity, lifetime, spread,
// direction and colour are all overridden live by the preset, so treat these as
// the shape of the effect rather than its final numbers.
//
// Materials live in CR_reactive.material and currently use placeholder
// textures. See Docs/CR_REACTIVE_PRESENTATION.md for the art request list.

// =============================================================================
// Dust
// =============================================================================

particle_system CR/Weather/DustNear
{
    material            CR_FX/Dust
    particle_width      3.5
    particle_height     3.5
    quota               2600
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               22
        emission_rate       240
        time_to_live_min    2.2
        time_to_live_max    3.6
        direction           -1 -0.3 0
        velocity_min        30
        velocity_max        52
        colour_range_start  0.72 0.47 0.26 0.55
        colour_range_end    0.58 0.36 0.20 0.35
        width               260
        height              90
        depth               260
    }

    affector ColourFader
    {
        alpha -0.18
    }

    // Dust drifts rather than falls; the randomiser stops the volume reading as
    // a flat sheet of identically-moving quads.
    affector DirectionRandomiser
    {
        randomness      6
        scope           0.35
        keep_velocity   true
    }
}

// Heavier grit that reads as debris being carried past the player. Sparse on
// purpose: it is punctuation for the dust, not a second dust layer.
particle_system CR/Weather/DustGrit
{
    material            CR_FX/Grit
    particle_width      0.9
    particle_height     0.9
    quota               400
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      oriented_self

    emitter Box
    {
        angle               10
        emission_rate       26
        time_to_live_min    1.2
        time_to_live_max    2.0
        direction           -1 -0.2 0
        velocity_min        44
        velocity_max        68
        colour_range_start  0.78 0.56 0.34 0.85
        colour_range_end    0.62 0.42 0.24 0.60
        width               160
        height              26
        depth               160
    }
}

// =============================================================================
// Snow
// =============================================================================

particle_system CR/Weather/SnowLight
{
    material            CR_FX/Snow
    particle_width      0.7
    particle_height     0.7
    quota               1400
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               32
        emission_rate       55
        time_to_live_min    7
        time_to_live_max    11
        direction           0 -1 0
        velocity_min        3
        velocity_max        7
        colour_range_start  0.88 0.92 1.00 0.70
        colour_range_end    0.80 0.86 1.00 0.45
        width               200
        height              30
        depth               200
    }

    affector DirectionRandomiser
    {
        randomness      3
        scope           0.6
        keep_velocity   true
    }
}

