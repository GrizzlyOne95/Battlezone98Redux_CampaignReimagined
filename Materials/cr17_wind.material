// Generated by Tools/Build-FoliageWindMaterial.py from cr17_surface.material.
// Edit that tool, not this file.
//
// Wind-swayed foliage. CR17/CutoutWind is CR17/Cutout on the cr17_wind.program
// vertex programs; meshes reference it through CR17/LeavesWind (tree canopies)
// and CR17/GroundWind (StaticGeometry ground cover), both baked by
// Tools/Bake-FoliageSway.py. CRFoliageWind writes the live wind into the pass
// emissive colour, so the material is still until it runs.

material CR17/CutoutCaster/FoliageWind
{
	technique
	{
		pass
		{
			scene_blend one one
			scene_blend_op min
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			vertex_program_ref CR17_Wind_Caster_vertex
			{
				param_named windShape float4 0.6 0.7 0.18 5.5
			}
			fragment_program_ref CR17_Cutout_Caster_fragment
			{
				param_named cutoutParams float4 0.45 0 0 0
			}
			texture_unit diffuseMap
			{
				texture cr17_foliage.dds
			}
		}
	}
}

