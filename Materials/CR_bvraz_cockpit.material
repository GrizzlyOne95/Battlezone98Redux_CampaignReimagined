import * from "CR_BZBase.material"

material CRV/BDogScoutCockpit : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap crvbscp_d.dds
    set_texture_alias NormalMap crvbscp_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvbscp_e.dds
}

material CRV/BDogScoutNose : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap bvraz_D.dds
    set_texture_alias NormalMap bvraz_N.dds
    set_texture_alias SpecularMap bvraz_S.dds
    set_texture_alias EmissiveMap bvraz_E.dds
}
