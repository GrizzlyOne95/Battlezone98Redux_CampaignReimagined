import * from "CR_BZBase.material"
material cromine : CR_BZBase
{
    set_texture_alias DiffuseMap cromine_d.dds
    set_texture_alias NormalMap cromine_N.dds
    set_texture_alias SpecularMap boltmine00_SPEC.dds
    set_texture_alias EmissiveMap cromine_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".55 .45 .25"
    set $shininess "80"
    set $glow "1 1 1"
}
