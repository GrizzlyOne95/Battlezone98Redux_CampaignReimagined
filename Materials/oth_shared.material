import * from "CR_BZBase.material"

material oth_src : CR_BZBase
{
 set_texture_alias DiffuseMap oth_src_d.dds
 set_texture_alias NormalMap ohp_src_n.dds
 set_texture_alias SpecularMap ohp_src_s.dds
 set_texture_alias EmissiveMap ohp_src_e.dds
 set $diffuse "1.0 1.0 1.0"
 set $ambient "1 1 1"
 set $specular ".55 .55 .55"
 set $shininess "70"
 set $glow "0.55 0.55 0.55"
}

material oth_src_cp : CR_BZBaseCockpit
{
 set_texture_alias DiffuseMap oth_src_d.dds
 set_texture_alias NormalMap ohp_src_n.dds
 set_texture_alias SpecularMap ohp_src_s.dds
 set_texture_alias EmissiveMap ohp_src_e.dds
 set $diffuse "1.0 1.0 1.0"
 set $ambient "1 1 1"
 set $specular ".55 .55 .55"
 set $shininess "70"
 set $glow "0.55 0.55 0.55"
}

material oth_metal : CR_BZBase
{
 set_texture_alias DiffuseMap oth_src_d.dds
 set_texture_alias NormalMap ohp_dark_n.dds
 set_texture_alias SpecularMap ohp_src_s.dds
 set_texture_alias EmissiveMap ohp_dark_e.dds
 set $diffuse "1.0 1.0 1.0"
 set $ambient "1 1 1"
