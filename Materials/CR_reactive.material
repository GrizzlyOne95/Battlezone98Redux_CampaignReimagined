// Impact billboards
// =============================================================================

// WANTED: cr_spark.png -- short bright metal spark streak, ~32x8.
material CR_FX/Spark : BZSprite/Additive
{
	set_texture_alias DiffuseMap bulhit.png
}

// WANTED: cr_bloom.png -- hot impact bloom, white core to orange edge, ~64x64.
material CR_FX/Bloom : BZSprite/Additive
{
	set_texture_alias DiffuseMap blast.png
}

// WANTED: cr_debris.png -- dark debris fleck sheet, ~32x32.
material CR_FX/Debris : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap smoke.png
}

// WANTED: cr_ion.png -- ionised discharge, cyan filaments, ~64x64.
material CR_FX/Ion : BZSprite/Additive
{
