// =============================================================================
// Transient hit states and persistent damage states
//
// DELIBERATELY NOT DEFINED YET.
//
// CRReactive.lua checks exu.MaterialExists before assigning any of these names,
// so an undefined state is skipped rather than applied. That is the correct
// placeholder behaviour here: defining CR_Hit/Ionized as an empty child of
// CR_BZBase would give it no textures and repaint the struck hull blank, which
// is worse than showing nothing. Impact particles, damage particles, emissive
// failure and the cockpit reaction all work without these.
//
// The names CRReactiveProfiles.lua asks for, and what each one should be:
//
//   CR_Hit/Ionized      brief blue-white emissive flash over the hull
//   CR_Hit/Scorch       soot and heat discoloration at the impact area
//   CR_Hit/BioSurge     cyan luminescence propagating through a Fury hull
//
//   CR_Dmg/Scarred      light battle damage: scoring, scuffed paint
//   CR_Dmg/Failing      heavy damage: panel loss, exposed structure, soot
//   CR_Dmg/Critical     blackened, buckled, glowing stress fractures
//   CR_Dmg/BioScarred   Fury equivalent: luminescence instability
//   CR_Dmg/BioFailing   Fury equivalent: dimmed channels, dark intervals
//   CR_Dmg/BioCritical  Fury equivalent: severe pulsing, bright surges
//
// Each is authored the same way as any other CR craft material -- one child of
// CR_BZBase per state, with its own damaged texture set:
//
//   material CR_Dmg/Failing : CR_BZBase
//   {
//       set_texture_alias DiffuseMap  cr_dmg_failing_D.dds
//       set_texture_alias NormalMap   cr_dmg_failing_N.dds
//       set_texture_alias SpecularMap cr_dmg_failing_S.dds
//       set_texture_alias EmissiveMap cr_dmg_failing_E.dds
//   }
//
// A per-craft variant can be added later by giving that craft's profile in
// CRReactiveProfiles.lua its own damageProfile with craft-specific names; the
// controller does not care how many exist, only that the ones it is told about
// resolve.

// =============================================================================
// Weather skydomes
//
// Only used when a mission tells CRWeather what its base sky is, because Ogre
// exposes the skydome's generation parameters but not its material name, so the
// controller cannot otherwise discover what to restore.
//
// WANTED: 2048x2048 dome textures per storm type. Until they exist these are
// left pointing at a flat placeholder, which reads as a featureless overcast.
// =============================================================================

material CR_Sky/MarsStorm : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap white.png
}

material CR_Sky/Blizzard : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap white.png
}

material CR_Sky/AshFall : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap white.png
}

material CR_Sky/Spore : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap white.png
}

material CR_Sky/Storm : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap white.png
}
