// Damage-state billboards
// =============================================================================

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/SmokeThin : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_smokethin.dds
