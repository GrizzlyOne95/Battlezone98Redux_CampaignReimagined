// CR_reactive.material
//
// Materials for the Campaign Reimagined reactive presentation and weather
// layers: particle billboards, transient hit states, persistent damage states,
// and the optional weather skydomes.
//
// PLACEHOLDER ART. Every texture reference below points at an asset Campaign
// Reimagined already ships so the systems render and can be profiled today. The
// comment above each block names the texture the art pass should supply.
// Docs/CR_REACTIVE_PRESENTATION.md carries the same list in one place.
//
// Particle billboards inherit BZSprite/AlphaBlend and BZSprite/Additive, which
// is the pipeline Redux and CR already use for in-world sprite quads. The
// CR_Effect shader those parents use multiplies the texture by the incoming
// vertex colour, so Ogre emitter colour_range values and exu.SetParticleEmitterColor
// tint these correctly.

import * from "sprites.material"

// =============================================================================
// Weather billboards
// =============================================================================

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Additive, not alpha_blend: the source streak is opaque with a black
// field, which is how it was authored to composite.
material CR_FX/Rain : BZSprite/Additive
{
	set_texture_alias DiffuseMap cr_rain.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Additive for the same reason as CR_FX/Rain.
material CR_FX/RainSplash : BZSprite/Additive
{
	set_texture_alias DiffuseMap cr_rainsplash.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// A flake silhouette. The particle colour is what makes it white, so the
// source being an ash flake does not show.
material CR_FX/Snow : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_snow.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/Dust : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_dust.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/Grit : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_grit.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Peak alpha 182: thin enough to layer without stacking into a wall.
material CR_FX/Haze : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_haze.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Peak alpha 68. Deliberately the faintest in the set -- the sheet is
// meant to read only once many cards overlap.
material CR_FX/DustSheet : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_dustsheet.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// The volcano flank's ground layer, not the plains one. Peak alpha 74 like
// DustSheet, but the card snakes vertically instead of streaming flat, which
// is what CRWeatherPresets describes SlopeDust as doing.
material CR_FX/SlopeWisp : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_slopewisp.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/DustDevil : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_dustdevil.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Peak alpha 199 over a 1265x619 card. This is the one the old note asked
// for: a large, near-structureless dust veil that gets its density from
// stacking rather than from any single card.
material CR_FX/Haboob : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_haboob.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/IceVeil : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_iceveil.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/Ash : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_ash.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
material CR_FX/Ember : BZSprite/Additive
{
	set_texture_alias DiffuseMap cr_ember.dds
}

// Kenshi PSO art (SCARaw, CC-BY-SA 4.0) -- see Docs/WEATHER_ART_CREDITS.md
// Moved off Additive: this source carries real alpha, and additive made a
// drifting mote glow like an ember.
material CR_FX/Spore : BZSprite/AlphaBlend
{
	set_texture_alias DiffuseMap cr_spore.dds
}

