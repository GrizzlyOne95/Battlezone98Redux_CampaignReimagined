// WANTED: cr_ember.png -- hot ember point with a bloom halo, ~32x32.
material CR_FX/Ember : BZSprite/Additive
{
	set_texture_alias DiffuseMap flare.png
}

// WANTED: cr_spore.png -- luminous alien spore, soft ring structure, ~64x64.
