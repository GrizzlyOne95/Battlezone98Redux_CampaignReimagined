import * from "CR_BZBase.material"

material apwrck00 : CR_BZBase
{
	set_texture_alias DiffuseMap crvsalv_d.dds
	set_texture_alias NormalMap crvpkup_n.dds
	set_texture_alias SpecularMap apwrck00_S.dds
	set_texture_alias EmissiveMap apwrck00_E.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}

