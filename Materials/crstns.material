import * from "CR_BZBase.material"

material crstns : CR_BZBase
{
    set_texture_alias DiffuseMap crstns_d.dds
    set_texture_alias NormalMap crvstor_n.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crstns_e.dds
    set_texture_alias ACTMap crstns_ACT.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}
