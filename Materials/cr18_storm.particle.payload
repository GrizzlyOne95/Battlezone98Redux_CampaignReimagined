        angle               18
        emission_rate       0
        time_to_live_min    2.8
        time_to_live_max    4.6
        direction           0 -0.3 1
        velocity_min        7
        velocity_max        13
        colour_range_start  0.46 0.27 0.17 0.55
        colour_range_end    0.34 0.20 0.13 0.35
        width               24
        height              3
        depth               14
    }

    affector ColourFader
    {
        alpha -0.12
    }

    affector Scaler
    {
        rate 3.5
    }
}

