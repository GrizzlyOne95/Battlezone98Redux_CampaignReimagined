{
    material            CR18/Chunk
    particle_width      1.7
    particle_height     1.7
    quota               420
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               14
        emission_rate       20
        time_to_live_min    1.1
        time_to_live_max    2.0
        direction           -1 0.08 0
        velocity_min        52
        velocity_max        92
        colour_range_start  0.22 0.15 0.12 0.95
        colour_range_end    0.14 0.10 0.09 0.80
        width               170
        height              26
        depth               170
    }

    affector ColourFader
    {
        alpha -0.12
    }

    affector Rotator
    {
        rotation_speed_range_start  -420
        rotation_speed_range_end     420
        rotation_range_start         0
        rotation_range_end           360
    }

    affector DirectionRandomiser
    {
        randomness      9
        scope           0.45
        keep_velocity   true
    }
}

// =============================================================================
// Tornado (world placed, local space: the node moves and turns, particles ride)
// =============================================================================

// Lower funnel, ground to ~55 m. Rotator turns each card on its own axis too.
// [0] ColourFader, [1] Scaler, [2] Rotator.
particle_system CR18/TornadoBase
{
    material            CR18/Funnel
    particle_width      18.0
    particle_height     34.0
    quota               260
    cull_each           true
    sorted              false
    local_space         true
    billboard_type      oriented_common
    common_direction    0 1 0

    emitter Ring
    {
        position            0 3 0
        angle               10
        emission_rate       70
        time_to_live_min    2.0
        time_to_live_max    2.8
        direction           0 1 0
        velocity_min        18
        velocity_max        26
        colour_range_start  0.32 0.13 0.09 0.60
        colour_range_end    0.20 0.08 0.06 0.40
        width               30
        height              4
        depth               30
        inner_width         0.50
        inner_height        0.50
    }

    affector ColourFader
    {
        alpha -0.17
    }

    affector Scaler
    {
        rate 6.0
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end     40
        rotation_range_start         0
        rotation_range_end           360
    }
}

