// cr18_storm.particle.payload
//
// Particle templates for the mission 18 storm (CRStorm18). Loaded on demand by
// CRParticleTemplates.EnsureExtra("cr18_storm"); a missing or malformed script
// costs this mission only. Ogre skips a malformed block silently (the only
// symptom is exu.CreateParticleSystem returning false), so CRStorm18 reports
// every template it could not create.
//
// Emitter and affector ORDER MATTERS: CRStorm18's presets and effects address
// them by zero-based index, exactly as cr_weather.particle.payload documents.
// Billboard materials are CR18/* (cr18_storm.material): RGBA-order sprites, so
// the colours below are the colours that draw.
//
// Three families:
//   weather   camera-attached volumes driven by CRWeather presets (world space)
//   tornado   world-placed columns (local_space true): CRStorm18Tornado moves the
//             node and turns it with SetParticleSystemDirection, so each stacked
//             band spins at its own rate
//   ground    emitter-slot decals and bursts (cracks, soot, slides): CRStorm18Ground
//             parks every emitter at rate 0 and pulses one slot per event

// =============================================================================
// Weather
// =============================================================================

// Wind-driven dust. [0] ColourFader, [1] DirectionRandomiser.
particle_system CR18/Dust
{
    material            CR18/Dust
    particle_width      4.5
    particle_height     4.5
    quota               2200
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               22
        emission_rate       200
        time_to_live_min    2.0
        time_to_live_max    3.4
        direction           -1 0.05 0
        velocity_min        26
        velocity_max        48
        colour_range_start  0.42 0.17 0.10 0.50
        colour_range_end    0.30 0.12 0.08 0.30
        width               240
        height              80
        depth               240
    }

    affector ColourFader
    {
        alpha -0.17
    }

    affector DirectionRandomiser
    {
        randomness      6
        scope           0.35
        keep_velocity   true
    }
}

// Stretched streaks: the layer that says how hard the wind blows.
// [0] ColourFader, [1] Scaler.
particle_system CR18/Streak
{
    material            CR18/Streak
    particle_width      11.0
    particle_height     2.4
    quota               700
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      oriented_self

    emitter Box
    {
        angle               6
        emission_rate       50
        time_to_live_min    1.4
        time_to_live_max    2.2
        direction           -1 0.02 0
        velocity_min        60
        velocity_max        95
        colour_range_start  0.50 0.20 0.11 0.40
        colour_range_end    0.34 0.13 0.08 0.00
        width               280
        height              16
        depth               280
    }

    affector ColourFader
    {
        alpha -0.20
    }

    affector Scaler
    {
        rate 2.4
    }
}

// Ground-hugging dark haze, large and slow: depth in the air in place of a
