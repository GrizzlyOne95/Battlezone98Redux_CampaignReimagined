// The cascade's mist (CRStorm18Water): one box at the foot of the fall. Emitter 0's
// rate is driven by the storm level; ColourFader and Scaler are fixed.
particle_system CR18/CascadeMist
{
    material CRWX_FX/Mist
    particle_width 6
    particle_height 5
    quota 260
    cull_each true
    sorted false
    local_space false
    billboard_type point

    emitter Box
    {
        width 12
        height 2
        depth 8
        direction 0 1 0
        angle 35
        emission_rate 18
        time_to_live_min 1.8
        time_to_live_max 3.6
        velocity_min 1
        velocity_max 3.5
        colour 0.62 0.60 0.58 0.16
    }

    affector ColourFader
    {
        alpha -0.05
    }

    affector Scaler
    {
        rate 1.3
    }
}

// Large, rare ruptures (CRStorm18Fissures). The mouth is a terrain-facing decal;
// upright additive shafts and escaping embers sell the light leaking upward.
// All start idle: Lua positions them and opens the emission envelope.
particle_system CR18/FissureMouth
{
    material CR18/FissureMouth
    particle_width 48
    particle_height 16
    quota 8
    cull_each true
    sorted false
    local_space false
    billboard_type perpendicular_self
    // Rotate the whole 3:1 decal; texcoord rotation clips/stretches its mouth.
    billboard_rotation_type vertex
    common_up_vector 0 0 -1
    emitter Point
    {
        emission_rate 0
        direction 0 1 0
        angle 0
        time_to_live 0.65
        velocity 0.001
        colour 1 1 1 1
    }

    affector ColourFader
    {
        alpha -0.25
    }
    // Lua fixes both ends to this rupture's bearing before emission.
    affector Rotator
    {
        rotation_speed_range_start 0
        rotation_speed_range_end 0
        rotation_range_start 0
        rotation_range_end 0
    }
}

