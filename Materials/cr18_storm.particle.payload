    emitter Box
    {
        angle               30
        emission_rate       80
        time_to_live_min    3.0
        time_to_live_max    5.5
        direction           -1 -0.35 0
        velocity_min        8
        velocity_max        22
        colour_range_start  0.16 0.12 0.11 0.85
        colour_range_end    0.10 0.08 0.07 0.55
        width               200
        height              70
        depth               200
    }

    affector ColourFader
    {
        alpha -0.04
    }

    affector Rotator
    {
        rotation_speed_range_start  -120
        rotation_speed_range_end     120
        rotation_range_start         0
        rotation_range_end           360
    }
}

