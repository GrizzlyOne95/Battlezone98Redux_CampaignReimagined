// The scorched stain under a crack: alpha blended near-black, so the glow has
// something to burn against. Held for most of its 26 s, then faded; the director
// lays it again at 21 s while the crack is in view. [0] ColourInterpolator.
particle_system CR18/Soot
{
    material            CR18/Puff
    particle_width      13.0
    particle_height     13.0
    quota               120
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      perpendicular_self
    common_up_vector    0 0 -1

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        26
        direction           0 1 0
        velocity            0.001
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.03 0.02 0.02 0.00
        time1   0.04
        colour1 0.03 0.02 0.02 0.62
        time2   0.74
        colour2 0.03 0.02 0.02 0.62
        time3   0.86
        colour3 0.03 0.02 0.02 0.30
        time4   0.95
        colour4 0.03 0.02 0.02 0.08
        time5   1.00
        colour5 0.03 0.02 0.02 0.00
    }

    affector Rotator
    {
        rotation_speed_range_start  0
        rotation_speed_range_end    0
        rotation_range_start        0
        rotation_range_end          360
    }
}

// A burst of dust where the ground splits. Six Point slots; a slot fired at rate
