        rotation_range_start         0
        rotation_range_end           360
    }
}

// Ground decals, the CRGroundFX.Print pattern: six Point emitters ("slots"),
// each fired for a blink at a ground point, particle flat on the ground
// (perpendicular_self, emitter direction = ground normal) at a random turn.
// The glow pulses through a ColourInterpolator over its 18 s life; the
// director re-lays a crack that is still near the camera before it fades.
// ColourInterpolator replaces the colour outright, so the heat tint is here.
particle_system CR18/CrackA
{
    material            CR18/CrackA
    particle_width      9.0
    particle_height     9.0
    quota               120
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      perpendicular_self
    common_up_vector    0 0 -1

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    emitter Point
    {
        angle               0
        emission_rate       0
        time_to_live        18
        direction           0 1 0
        velocity            0.001
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.0 0.0 0.0 0.0
        time1   0.05
        colour1 1.0 0.85 0.55 1.0
        time2   0.22
        colour2 0.55 0.30 0.16 0.70
        time3   0.46
        colour3 1.0 0.72 0.40 0.95
        time4   0.78
        colour4 0.60 0.32 0.16 0.65
        time5   1.00
        colour5 0.0 0.0 0.0 0.0
    }

    affector Rotator
    {
        rotation_speed_range_start  0
        rotation_speed_range_end    0
        rotation_range_start        0
        rotation_range_end          360
    }
}

