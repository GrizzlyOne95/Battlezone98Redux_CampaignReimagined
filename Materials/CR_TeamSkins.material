	set_texture_alias ACTMap cvhaul_ACT.dds
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set_texture_alias TeamMask crteam_cvhaul_d.dds
}

