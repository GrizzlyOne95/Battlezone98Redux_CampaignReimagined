material CR_UI
{
	// Ogre Panel/BorderPanel vertices have no COLOR0. Use the dedicated
	// panel path on D3D11; the historical UI path below remains the fallback.
	technique
	{
		pass
		{
			vertex_program_ref CR_OverlayPanel_vertexHLSL4
			{
			}
			fragment_program_ref CR_OverlayTint_fragmentHLSL4
			{
				param_named_auto overlayColor surface_diffuse_colour
			}

			lighting off
			scene_blend alpha_blend
			depth_check off
			depth_write off

			texture_unit
			{
				texture white.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}

	technique
	{
		pass
		{
			vertex_program_ref CR_UI_vertex
			{
			}
			fragment_program_ref CR_UI_fragment
			{
			} 

			lighting off
			scene_blend alpha_blend
			depth_check off
			depth_write off

			texture_unit
			{
				texture white.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}
}

