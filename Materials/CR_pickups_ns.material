import * from "CR_BZBase.material"

material crnvns : CR_BZBase
{
    set_texture_alias DiffuseMap crnvns_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crnvns_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material cramns : CR_BZBase
{
    set_texture_alias DiffuseMap crpkns0_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap black.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material cramns/plain : cramns
{
    set_texture_alias DiffuseMap crpkns0_surf.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
}

