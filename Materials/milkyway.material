material MILKYWAY.MAP
{
	technique
	{
		pass
		{
			vertex_program_ref CR_Sky_vertex
			{
			}
			fragment_program_ref CR_Sky_fragment
			{
			} 

			cull_hardware none
			cull_software none 
			lighting off
			// Twinkle control (twinkleControl in CR_Sky_fragment). 0 = the stock
			// steady star field; RuntimeEnhancements raises it to 1 when the
			// StarTwinkle option is on.
			emissive 0 0 0
			fog_override true none
			scene_blend src_alpha one
			depth_write off
			diffuse vertexcolour
			texture_unit
			{
				tex_address_mode clamp
				texture milkyway.dds
			}
		}
	}
}

