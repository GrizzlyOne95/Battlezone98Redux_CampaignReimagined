import * from "CR_BZBase.material"

material savfury : CR_BZBase
{
	set_texture_alias DiffuseMap savfury_d.dds
	set_texture_alias NormalMap svsav_N.dds
	set_texture_alias SpecularMap svsav_S.dds
	set_texture_alias EmissiveMap savfury_e.dds
	set_texture_alias ACTMap svsav_ACT.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".6 .65 .7"
	set $shininess "110"
	set $glow "1 1 1"
}
