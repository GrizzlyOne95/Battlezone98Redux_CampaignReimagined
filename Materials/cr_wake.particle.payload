// cr_wake.particle
//
// Ogre particle templates for the shared ground-kickup module (CRWake.lua):
// surface-appropriate debris under low, moving craft and under pilots on foot.
// One system per tracked craft or pilot (plus an optional flat ring system over
// water), parked on the ground under it by the module, which drives emitter
// rates from speed and height and AIMS the emitters at run time (exu emitter
// direction / velocity / time-to-live): spray trails behind the mover, not
// straight up.
//
// PHYSICS. Airless worlds (Ganymede, Europa, Io; the Moon's own template is in
// cr_moon.particle.payload) are vacuum templates: NO Scaler growth (nothing
// billows without air), LinearForce = the real surface gravity, alpha held
// until the last ~0.6 s then faded (ColourFader2), so grains fly clean
// parabolas and vanish, they do not hang. Worlds with air (Mars, Venus, grass,
// mud, water) keep a modest billow and a drag-softened fall. Keep each
// LinearForce equal to CRWake.V.Profiles[...].g (or its `fall` where a template
// is deliberately softer): the pilot apex cap and the vacuum TTL use them.
//
// Materials: CR_FX/KickRegolith, KickIce, KickClod and KickPuff (sprite art converted by
// Tools/Build-KickupTextures.py; KickPuff is the soft dust puff for the air worlds) plus
// CRWX_FX/*. KickClod is already coloured (brown with grass blades): the mud and grass
// templates tint it near neutral instead of brown-on-brown. Every kickup template carries a Rotator so a sprite never reads
// as one repeated shape (one Rotator serves both emitters: Ogre cannot give
// the chips a different spin; the dust/chip size is likewise one per system).
// Quotas are deliberately small: the module keeps at most a handful of these
// alive at once and only near the viewer.
//
// Emitter ORDER MATTERS: CRWake sets the rate and aim of emitter 0 (the body)
// and emitter 1 (the chips) by index. Vacuum affectors: 0 ColourFader2,
// 1 Rotator, 2 LinearForce. Air affectors: 0 ColourInterpolator, 1 Scaler,
// 2 LinearForce, 3 Rotator.

// =============================================================================
// Mars -- red-ochre dust and rock chips (thin air: a little billow)
// =============================================================================

//   emitter 0  Box under the craft: dust
//   emitter 1  Box: faster, shorter-lived chips
particle_system CRWake/MarsDust
{
    material            CR_FX/KickPuff
    particle_width      0.9
    particle_height     0.9
    quota               80
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               35
        emission_rate       0
        time_to_live_min    1.6
        time_to_live_max    2.8
        direction           1 0.35 0
        velocity_min        2
        velocity_max        6
        colour_range_start  0.74 0.46 0.28 0.00
        colour_range_end    0.68 0.40 0.24 0.00
        width               3
        height              0.3
        depth               3
    }

    emitter Box
    {
        angle               22
        emission_rate       0
        time_to_live_min    0.5
        time_to_live_max    0.9
        direction           0.6 1 0
        velocity_min        2.5
        velocity_max        8
        colour_range_start  0.42 0.26 0.18 0.00
        colour_range_end    0.34 0.20 0.14 0.00
        width               2
        height              0.2
        depth               2
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.74 0.46 0.28 0.50
        time1   0.30
        colour1 0.72 0.44 0.27 0.45
        time2   0.70
        colour2 0.68 0.42 0.26 0.30
        time3   1.00
        colour3 0.62 0.38 0.24 0.00
    }

    affector Scaler
    {
        rate 0.35
    }

    affector LinearForce
    {
        force_vector        0 -3.71 0
        force_application   add
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }
}

// =============================================================================
// Europa -- ice powder and chips (vacuum)
// =============================================================================

//   emitter 0  Box: powder sheet
//   emitter 1  Box: bright chips
particle_system CRWake/IceSpray
{
    material            CR_FX/KickIce
    particle_width      0.7
    particle_height     0.7
    quota               100
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               30
        emission_rate       0
        time_to_live_min    1.5
        time_to_live_max    2.5
        direction           1 0.35 0
        velocity_min        2
        velocity_max        6
        colour_range_start  0.88 0.94 1.00 0.55
        colour_range_end    0.80 0.90 1.00 0.50
        width               3
        height              0.3
        depth               3
    }

    emitter Box
    {
        angle               20
        emission_rate       0
        time_to_live_min    1.0
        time_to_live_max    1.8
        direction           0.6 1 0
        velocity_min        2.5
        velocity_max        8
        colour_range_start  1.00 1.00 1.00 0.90
        colour_range_end    0.92 0.97 1.00 0.85
        width               2
        height              0.2
        depth               2
    }

    affector ColourFader2
    {
        red1 0
        green1 0
        blue1 0
        alpha1 0
        state_change 0.35
        red2 0
        green2 0
        blue2 0
        alpha2 -1.6
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }

    affector LinearForce
    {
        force_vector        0 -1.31 0
        force_application   add
    }
}

// =============================================================================
// Ganymede -- dirty regolith with bright ice glints (vacuum)
// =============================================================================

// Ganymede's surface is dark, dusty ice: emitter 0 is the dirty grey-brown dust sheet,
// emitter 1 the bright blue-white ice chips. KickIce for both; the colours do the rest.
//   emitter 0  Box: dirty dust sheet
//   emitter 1  Box: ice glints
particle_system CRWake/GanymedeSpray
{
    material            CR_FX/KickIce
    particle_width      0.7
    particle_height     0.7
    quota               100
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               30
        emission_rate       0
        time_to_live_min    1.5
        time_to_live_max    2.5
        direction           1 0.35 0
        velocity_min        2
        velocity_max        6
        colour_range_start  0.30 0.27 0.24 0.60
        colour_range_end    0.24 0.22 0.20 0.55
        width               3
        height              0.3
        depth               3
    }

    emitter Box
    {
        angle               20
        emission_rate       0
        time_to_live_min    1.0
        time_to_live_max    1.8
        direction           0.6 1 0
        velocity_min        2.5
        velocity_max        8
        colour_range_start  0.80 0.90 1.00 0.90
        colour_range_end    0.70 0.84 1.00 0.85
        width               2
        height              0.2
        depth               2
    }

    affector ColourFader2
    {
        red1 0
        green1 0
        blue1 0
        alpha1 0
        state_change 0.35
        red2 0
        green2 0
        blue2 0
        alpha2 -1.6
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }

    affector LinearForce
    {
        force_vector        0 -1.43 0
        force_application   add
    }
}

// =============================================================================
// Water -- spray and mist, plus a flat wake ring
// =============================================================================

//   emitter 0  Point spray, a cone thrown up and back
//   emitter 1  Box mist disc
//   affector 0 LinearForce          (gravity)
//   affector 1 ColourFader
particle_system CRWake/WaterSpray
{
    material            CR_FX/RainSplash
    particle_width      1.1
    particle_height     1.1
    quota               72
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               42
        emission_rate       0
        time_to_live_min    0.6
        time_to_live_max    1.1
        direction           0 1 0
        velocity_min        3.0
        velocity_max        7.0
        colour_range_start  0.90 0.96 1.00 0.55
        colour_range_end    0.78 0.88 0.96 0.35
    }

    emitter Box
    {
        angle               70
        emission_rate       0
        time_to_live_min    1.0
        time_to_live_max    1.8
        direction           0 1 0
        velocity_min        0.4
        velocity_max        1.4
        colour_range_start  0.84 0.90 0.94 0.20
        colour_range_end    0.78 0.86 0.92 0.12
        width               3
        height              0.2
        depth               3
    }

    affector LinearForce
    {
        force_vector        0 -7 0
        force_application   add
    }

    affector ColourFader
    {
        alpha -0.35
    }
}

// Flat ripples on the water under the craft. perpendicular_self faces each
// ring along its (tiny) velocity, which is straight up. Same recipe as
// CRWX/SplashRing in crwx_precip.particle.payload (additive: the fader takes
// the colour to black, which is transparent). The module creates this accent
// only when a system slot is spare.
//   emitter 0  Box disc
//   affector 0 Scaler
//   affector 1 ColourFader
particle_system CRWake/WaterRing
{
    material            CRWX_FX/SplashRing
    particle_width      0.5
    particle_height     0.5
    quota               24
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      perpendicular_self
    common_up_vector    0 0 1

    emitter Box
    {
        angle               0
        emission_rate       0
        time_to_live_min    0.9
        time_to_live_max    1.3
        direction           0 1 0
        velocity_min        0.01
        velocity_max        0.01
        colour              0.80 0.90 0.95 1
        width               3.5
        height              0
        depth               3.5
    }

    affector Scaler
    {
        rate 5.0
    }

    affector ColourFader
    {
        red   -0.55
        green -0.55
        blue  -0.55
    }
}

