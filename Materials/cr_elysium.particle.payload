// cr_elysium.particle
//
// Ogre particle templates for the Elysium storm director (CRElysiumWeather.lua),
// the Black Dog planet with an Earth-like sky. Elysium reuses the Venus engine
// and its cr_venus lightning (bolt, glow, St. Elmo), which are already blue-white;
// only the two sheets that carry the sulphur colour are repainted here, blue-grey
// rain cloud instead of sulphur. Same shape, quotas and emitter / affector order
// as CR/Venus/FogPool and CR/Venus/CloudDeck (the director addresses them by index).
//
// Materials are CRVenus/* in crart_venus.material, as for cr_venus.

// Low basins fill with grey mist.
particle_system CR/Elysium/FogPool
{
    material            CRVenus/Haze
    particle_width      64.0
    particle_height     64.0
    quota               90
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               30
        emission_rate       2.6
        time_to_live_min    24.0
        time_to_live_max    34.0
        direction           1 0 -0.7
        velocity_min        0.3
        velocity_max        1.1
        colour_range_start  0.55 0.60 0.68 0.00
        colour_range_end    0.48 0.53 0.61 0.00
        width               96
        height              7
        depth               96
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.55 0.60 0.68 0.00
        time1   0.20
        colour1 0.55 0.60 0.68 0.22
        time2   0.78
        colour2 0.50 0.55 0.63 0.18
        time3   1.00
        colour3 0.42 0.47 0.55 0.00
    }

    affector Scaler
    {
        rate 1.2
    }

    affector LinearForce
    {
        force_vector        0 0 0
        force_application   add
    }

    affector DirectionRandomiser
    {
        randomness  3
        scope       0.3
        keep_velocity true
    }
}

// Storm cloud deck riding the camera (tint is rewritten live with severity).
particle_system CR/Elysium/CloudDeck
{
    material            CRVenus/Smoke
    particle_width      150.0
    particle_height     150.0
    quota               60
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               20
        emission_rate       3.0
        time_to_live_min    14.0
        time_to_live_max    22.0
        direction           1 0 -0.7
        velocity_min        1.5
        velocity_max        4.5
        colour_range_start  0.34 0.38 0.45 0.00
        colour_range_end    0.29 0.33 0.40 0.00
        width               320
        height              14
        depth               320
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.34 0.38 0.45 0.00
        time1   0.22
        colour1 0.34 0.38 0.45 0.20
        time2   0.78
        colour2 0.29 0.33 0.40 0.16
        time3   1.00
        colour3 0.25 0.29 0.35 0.00
    }

    affector Rotator
    {
        rotation_speed_range_start  -6
        rotation_speed_range_end     6
        rotation_range_start          0
        rotation_range_end          360
    }

    affector LinearForce
    {
        force_vector        0 0 0
        force_application   add
    }
}
