// cr_moon.particle
//
// Ogre particle templates for the Moon weather director (CRMoonWeather.lua).
//
// The Moon has no atmosphere, so nothing here is driven by wind. What the
// director draws is the "horizon glow" look of electrostatically levitated dust
// (Surveyor) and regolith kicked up in 1/6 g: a thin, slow, pale grey-blue mist
// lying on the ground, and dust that hangs a while and settles gently.
//
// Every material below already exists in CR_reactive.material (CR_FX/Haze,
// CR_FX/Dust), so this file adds templates only -- no new art, no new materials.
//
// Ground mist uses flat (horizontal) cards, the same trick as CR/VenusGroundHaze:
// billboard_type perpendicular_common with common_direction 0 1 0 lays each card
// flat on the ground, so the mist stays a thin layer instead of a column of
// camera-facing puffs. A Box emitter's `direction` is its DEPTH axis, so with a
// horizontal direction `height` is the thin vertical axis (the mist's thickness).
//
// Emitter and affector ORDER MATTERS: CRMoonWeather addresses both by index.

// =============================================================================
// Ground mist -- one pool in low ground (streamed in around the player)
// =============================================================================

//   emitter 0  Box, 44 x 1.3 x 44 (the director lifts it to the mist height)
//   affector 0 ColourInterpolator   (director rewrites colour1/colour2 for the glow)
//   affector 1 Scaler
//   affector 2 DirectionRandomiser
particle_system CR/Moon/GroundMist
{
    material            CR_FX/Haze
    particle_width      34.0
    particle_height     34.0
    quota               90
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      perpendicular_common
    common_direction    0 1 0
    common_up_vector    0 0 1

    emitter Box
    {
        angle               12
        emission_rate       0
        time_to_live_min    18.0
        time_to_live_max    28.0
        direction           1 0 0.3
        velocity_min        0.04
        velocity_max        0.26
        colour_range_start  0.62 0.70 0.82 0.00
        colour_range_end    0.58 0.66 0.80 0.00
        width               44
        height              1.3
        depth               44
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.62 0.70 0.82 0.00
        time1   0.22
        colour1 0.64 0.72 0.84 0.11
        time2   0.72
        colour2 0.60 0.68 0.81 0.09
        time3   1.00
        colour3 0.55 0.63 0.78 0.00
    }

    affector Scaler
    {
        rate 0.35
    }

    affector DirectionRandomiser
    {
        randomness      1.5
        scope           0.30
        keep_velocity   true
    }
}

// =============================================================================
// Local mist -- the layer that follows the player (13 small emitters)
// =============================================================================

// One system at the player's ground position. The director moves it with the
// player and, a couple of times a second, puts each emitter on a sampled patch of
// terrain (a centre cell, an inner ring of 6 and an outer ring of 6), so the mist
// is denser over low ground and thins over ridges. Particles are left behind in
// the world, so a moving player trails and crosses a continuous blanket.
//
//   emitters 0-12  Box terrain patches (0 centre, 1-6 inner ring, 7-12 outer ring)
//   affector 0 ColourInterpolator   (director rewrites colour1/colour2 for the glow)
//   affector 1 Scaler
//   affector 2 DirectionRandomiser
