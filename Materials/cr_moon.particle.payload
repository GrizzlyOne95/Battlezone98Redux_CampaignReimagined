// =============================================================================
// Kick dust -- regolith thrown up by an impact; hangs, then settles
// =============================================================================

// A pooled one-shot: the director moves a parked system to the impact, raises the
// emission rate for about a fifth of a second and parks it again. The force is a
// gentle -0.45 on Y (lunar gravity is -1.6, but this is cohesive dust that has
// lost most of its speed to the ground; a lower pull is what makes it HANG).
//
//   emitter 0  Point burst (rate driven by the director)
//   affector 0 ColourInterpolator
//   affector 1 Scaler
//   affector 2 LinearForce
particle_system CR/Moon/KickDust
{
    material            CR_FX/Dust
    particle_width      3.4
    particle_height     3.4
    quota               70
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               58
        emission_rate       0
        time_to_live_min    6.0
        time_to_live_max    10.5
        direction           0 1 0
        velocity_min        0.7
        velocity_max        3.4
        colour_range_start  0.58 0.59 0.62 0.00
        colour_range_end    0.52 0.54 0.60 0.00
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.60 0.61 0.64 0.26
        time1   0.30
        colour1 0.58 0.60 0.64 0.20
        time2   0.70
        colour2 0.55 0.58 0.63 0.10
        time3   1.00
        colour3 0.50 0.54 0.60 0.00
    }

    affector Scaler
    {
        rate 0.45
    }

    affector LinearForce
    {
        force_vector        0 -0.45 0
        force_application   add
    }
}

// =============================================================================
// Hover dust -- fine regolith disturbed under a low, moving craft
// =============================================================================

// One system per tracked craft, parked on the ground under it. A low outward
// cone at very low speed; the director drives the rate from speed and height.
//
//   emitter 0  Box 5 x 0.4 x 5 (flat disc under the craft): dust
//   emitter 1  Box 3 x 0.2 x 3: rock chips (added for CRWake; emitter 0 is unchanged)
//   affector 0 ColourInterpolator
//   affector 1 Scaler
//   affector 2 LinearForce
particle_system CR/Moon/HoverDust
{
    material            CR_FX/Dust
    particle_width      2.6
    particle_height     2.6
    quota               90
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               82
        emission_rate       0
        time_to_live_min    4.0
        time_to_live_max    8.0
        direction           1 0 0.3
        velocity_min        0.5
        velocity_max        2.4
        colour_range_start  0.58 0.59 0.62 0.00
        colour_range_end    0.52 0.54 0.60 0.00
        width               5
        height              0.4
        depth               5
    }

    // Rock chips (CRWake drives this by index, ~35 % of the dust rate). Under 1/6 g
    // they leave faster and live longer than the dust, and the weak LinearForce
    // below lets them arc slowly and high. Grey; the shared Scaler keeps them small.
    emitter Box
    {
        angle               50
        emission_rate       0
        time_to_live_min    2.0
        time_to_live_max    3.5
        direction           0 1 0
        velocity_min        3.0
        velocity_max        7.0
        colour_range_start  0.40 0.40 0.42 0.00
        colour_range_end    0.34 0.34 0.37 0.00
        width               3
        height              0.2
        depth               3
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.60 0.61 0.64 0.16
        time1   0.30
        colour1 0.58 0.60 0.64 0.12
        time2   0.70
        colour2 0.55 0.58 0.63 0.06
        time3   1.00
        colour3 0.50 0.54 0.60 0.00
    }

    affector Scaler
    {
        rate 0.40
    }

    affector LinearForce
    {
        force_vector        0 -0.50 0
        force_application   add
    }
}
