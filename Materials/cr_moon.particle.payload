// =============================================================================
// Kick dust -- regolith thrown up by an impact; flies a parabola, then fades
// =============================================================================

// A pooled one-shot: the director moves a parked system to the impact, raises the
// emission rate for about a fifth of a second and parks it again. Vacuum physics
// (the same rule as the CRWake kickup): no Scaler growth, LinearForce = lunar
// gravity (1.62), alpha held until the last 0.6 s then faded, so the grains
// fly parabolas and vanish instead of hanging. A grain launched at v lands
// after 2 v / g (1 m/s: 1.2 s, 4.5 m/s: 5.5 s); TTL covers most of that spread.
//
//   emitter 0  Point burst (rate driven by the director)
//   affector 0 ColourFader2
//   affector 1 Rotator
//   affector 2 LinearForce
particle_system CR/Moon/KickDust
{
    material            CR_FX/KickRegolith
    particle_width      0.9
    particle_height     0.9
    quota               70
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               58
        emission_rate       0
        time_to_live_min    1.2
        time_to_live_max    4.0
        direction           0 1 0
        velocity_min        1.0
        velocity_max        4.5
        colour_range_start  0.60 0.60 0.58 0.60
        colour_range_end    0.52 0.52 0.51 0.55
    }

    affector ColourFader2
    {
        red1 0
        green1 0
        blue1 0
        alpha1 0
        state_change 0.6
        red2 0
        green2 0
        blue2 0
        alpha2 -1.0
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }

    affector LinearForce
    {
        force_vector        0 -1.62 0
        force_application   add
    }
}

// =============================================================================
// Hover dust -- fine regolith disturbed under a low, moving craft
// =============================================================================

// One system per tracked craft or pilot, parked on the ground under it (CRWake). Vacuum: no growth,
// LinearForce = lunar gravity (1.62), alpha held then faded, grains fly parabolas. CRWake aims both
// emitters and sets their velocity and TTL per mover; the values here are only the defaults.
//
//   emitter 0  Box 3 x 0.3 x 3: dust sheet
//   emitter 1  Box 2 x 0.2 x 2: rock chips
//   affector 0 ColourFader2
//   affector 1 Rotator
//   affector 2 LinearForce
particle_system CR/Moon/HoverDust
{
    material            CR_FX/KickRegolith
    particle_width      0.8
    particle_height     0.8
    quota               100
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               30
        emission_rate       0
        time_to_live_min    1.5
        time_to_live_max    2.5
        direction           1 0.35 0
        velocity_min        2
        velocity_max        6
        colour_range_start  0.60 0.60 0.58 0.55
        colour_range_end    0.54 0.54 0.53 0.50
        width               3
        height              0.3
        depth               3
    }

    emitter Box
    {
        angle               20
        emission_rate       0
        time_to_live_min    1.0
        time_to_live_max    1.8
        direction           0.6 1 0
        velocity_min        2.5
        velocity_max        8
        colour_range_start  0.42 0.42 0.41 0.85
        colour_range_end    0.36 0.36 0.35 0.80
        width               2
        height              0.2
        depth               2
    }

    affector ColourFader2
    {
        red1 0
        green1 0
        blue1 0
        alpha1 0
        state_change 0.35
        red2 0
        green2 0
        blue2 0
        alpha2 -1.6
    }

    affector Rotator
    {
        rotation_speed_range_start  -40
        rotation_speed_range_end    40
        rotation_range_start        0
        rotation_range_end          360
    }

    affector LinearForce
    {
        force_vector        0 -1.62 0
        force_application   add
    }
}
