    local_space         false
    billboard_type      perpendicular_common
    common_direction    0 1 0
    common_up_vector    0 0 1

    emitter Box
    {
        angle               14
        emission_rate       0
        time_to_live_min    16.0
        time_to_live_max    24.0
        direction           1 0 0.3
        velocity_min        0.04
        velocity_max        0.26
        colour_range_start  0.62 0.70 0.82 0.00
        colour_range_end    0.58 0.66 0.80 0.00
