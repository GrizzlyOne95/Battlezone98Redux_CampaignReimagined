			{
			}
			fragment_program_ref CR_Textured_fragment
			{
				param_named fogColour float3 0 0 0
			} 

			texture_unit emissiveMap
			{
				texture_alias EmissiveMap
				texture black.png
			}
		}
	}
}

material CR_BZBaseCockpit
{
	receive_shadows off

	set $shininess "32"
    set $ambient "1 1 1"
    set $diffuse "1 1 1"
	set $specular "1 1 1"
	set $bias "0"
	set $glow "1 1 1"
	
