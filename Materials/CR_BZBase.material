abstract pass BZPassSchemeHighPSSM
{
	vertex_program_ref OSE_BaseHighPSSM_vertex
	{
	}
	fragment_program_ref OSE_BaseHighPSSM_fragment
	{
	}

	ambient $ambient
	diffuse $diffuse
	specular $specular $shininess	
	depth_bias $bias

	texture_unit diffuseMap
	{
		texture_alias DiffuseMap
		texture white.png
	}

	texture_unit normalMap
	{
		texture_alias NormalMap
		texture flat_n.png
	}

	texture_unit specularMap
	{
		texture_alias SpecularMap
		texture white.png
	}

	texture_unit emissiveMap
	{
		texture_alias EmissiveMap
		texture black.png
	}
	
	texture_unit shadowMap1
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
	}
	
	texture_unit shadowMap2
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
	}
	
	texture_unit shadowMap3
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
	}
}

// DX11 Enhanced-only PSSM v2. This separate pass is the material-state half
// of the compile-time A/B boundary: comparison sampling must never leak into
// Classic's manual-depth-compare shader.
abstract pass BZPassSchemeENHighPSSMV2
{
	vertex_program_ref OSE_BaseENHighPSSMV2_vertex
	{
	}
	fragment_program_ref OSE_BaseENHighPSSM_fragment
	{
	}

	ambient $ambient
	diffuse $diffuse
	specular $specular $shininess
	depth_bias $bias

	texture_unit diffuseMap
	{
		texture_alias DiffuseMap
		texture white.png
	}

	texture_unit normalMap
	{
		texture_alias NormalMap
		texture flat_n.png
	}

	texture_unit specularMap
	{
		texture_alias SpecularMap
		texture white.png
	}

	texture_unit emissiveMap
	{
		texture_alias EmissiveMap
		texture black.png
	}

	texture_unit shadowMap1
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
		filtering bilinear
		compare_test on
		compare_func greater_equal
	}

	texture_unit shadowMap2
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
		filtering bilinear
		compare_test on
		compare_func greater_equal
	}

	texture_unit shadowMap3
	{
		content_type shadow
		tex_address_mode border
		tex_border_colour 1.0 1.0 1.0 1.0
		filtering bilinear
		compare_test on
		compare_func greater_equal
	}
}


