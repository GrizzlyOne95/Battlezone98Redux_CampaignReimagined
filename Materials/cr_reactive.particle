// =============================================================================
// Damage states -- conventional
// =============================================================================

// Moderate damage: occasional sparks, no smoke. A craft at 60% health should be
// legibly worse off without becoming a smoke marker on the battlefield.
particle_system CR/Damage/SparkIntermittent
{
    material            CR_FX/Spark
    particle_width      0.14
    particle_height     0.45
    quota               60
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      oriented_self

    emitter Point
    {
        angle               60
        emission_rate       7
        time_to_live_min    0.15
        time_to_live_max    0.40
        direction           0 -1 0
        velocity_min        3
        velocity_max        9
        colour_range_start  1.00 0.85 0.50 1.00
        colour_range_end    1.00 0.45 0.10 0.70
    }

    affector LinearForce
    {
        force_vector        0 -18 0
        force_application   add
    }

    affector ColourFader
    {
        alpha -2.4
    }
}

