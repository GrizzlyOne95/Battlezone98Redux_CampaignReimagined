// cr_reactive.particle
//
// Ogre particle templates for the Campaign Reimagined reactive presentation
// layer: weapon-specific impact bursts and persistent damage-state VFX.
//
// Two very different lifetimes live in this file.
//
// Impact systems are pooled. CRReactive keeps a small fixed set alive, moves one
// to the hit position, lets it emit for a fraction of a second, then parks it.
// They must therefore reach full visual effect almost immediately and die
// quickly: emission_rate is high and time_to_live is short.
//
// Damage systems are attached to a craft's own scene node and run continuously
// while that craft sits in a damage band. They must be cheap, because several
// can be alive at once, and they must read at a distance without becoming the
// loudest thing on screen.
//
// Emitter ORDER MATTERS where a preset or profile addresses emitters by index.
// Index 0 is the emitter declared first in each block.

// =============================================================================
// Impact -- conventional armour
// =============================================================================

// Machine guns: sharp, small, over instantly. No smoke -- a rifle round on
// armour is a spark, and adding smoke here is what makes a firefight read as
// mud rather than as gunfire.
particle_system CR/Impact/SparkSmall
{
    material            CR_FX/Spark
    particle_width      0.18
    particle_height     0.55
    quota               160
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      oriented_self

    emitter Point
    {
        angle               75
        emission_rate       420
        time_to_live_min    0.10
        time_to_live_max    0.28
        direction           0 1 0
        velocity_min        7
        velocity_max        18
        colour_range_start  1.00 0.88 0.55 1.00
        colour_range_end    1.00 0.52 0.12 0.85
    }

    affector LinearForce
    {
        force_vector        0 -22 0
        force_application   add
    }

    affector ColourFader
    {
        red     -1.6
        green   -2.6
        blue    -3.2
        alpha   -3.0
    }
}

// Cannons: a broader hot bloom plus heavier sparks. Two emitters, bloom first.
particle_system CR/Impact/BloomHot
{
    material            CR_FX/Bloom
    particle_width      1.8
    particle_height     1.8
    quota               120
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               25
        emission_rate       90
        time_to_live_min    0.14
        time_to_live_max    0.30
        direction           0 1 0
        velocity_min        1
        velocity_max        4
        colour_range_start  1.00 0.92 0.72 1.00
        colour_range_end    1.00 0.46 0.10 0.85
    }

    emitter Point
    {
        angle               85
        emission_rate       260
        time_to_live_min    0.16
        time_to_live_max    0.40
        direction           0 1 0
        velocity_min        10
        velocity_max        26
        colour_range_start  1.00 0.80 0.42 1.00
        colour_range_end    1.00 0.40 0.08 0.70
    }

    affector Scaler
    {
        rate 6
    }

    affector ColourFader
    {
        alpha -3.2
    }
}

// Rockets, missiles and mortars: flash, then a debris and smoke burst that
// lingers just long enough to be read as an explosion rather than a flash.
particle_system CR/Impact/BlastSmoke
{
    material            CR_FX/SmokeHeavy
    particle_width      2.4
    particle_height     2.4
    quota               260
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               70
        emission_rate       200
        time_to_live_min    0.7
        time_to_live_max    1.6
        direction           0 1 0
        velocity_min        4
        velocity_max        13
        colour_range_start  0.42 0.38 0.35 0.85
        colour_range_end    0.20 0.19 0.18 0.55
    }

    emitter Point
    {
        angle               90
        emission_rate       160
        time_to_live_min    0.20
        time_to_live_max    0.50
        direction           0 1 0
        velocity_min        12
        velocity_max        30
        colour_range_start  1.00 0.72 0.30 1.00
        colour_range_end    0.70 0.24 0.05 0.60
    }

    affector Scaler
    {
        rate 3.5
    }

    affector ColourFader
    {
        alpha -0.85
    }
}

// Energy and charge weapons: an ionised discharge that spreads across the
// surface rather than throwing metal off it.
particle_system CR/Impact/EnergyDischarge
{
    material            CR_FX/Ion
    particle_width      1.4
    particle_height     1.4
    quota               180
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               90
        emission_rate       260
        time_to_live_min    0.16
        time_to_live_max    0.45
        direction           0 1 0
        velocity_min        5
        velocity_max        16
        colour_range_start  0.62 0.94 1.00 1.00
        colour_range_end    0.20 0.48 0.95 0.65
    }

    affector Scaler
    {
        rate 4
    }

    affector ColourFader
    {
        red     -1.2
        green   -1.6
        blue    -0.8
        alpha   -2.6
    }
}

