// Mission-local, loaded on EvacLaunch. Four bounded instances of each system.
particle_system CR/M16/Exhaust
{
    material CR_FX/Bloom
    particle_width 4.8
    particle_height 11
    quota 170
    cull_each true
    sorted false
    local_space false
    billboard_type oriented_self
    emitter Point
    {
        angle 7
        emission_rate 0
        time_to_live_min 0.28
        time_to_live_max 0.52
        direction 0 -1 0
        velocity_min 48
        velocity_max 68
        colour_range_start 0.35 0.85 1 0.9
        colour_range_end 0.08 0.32 1 0.65
    }
    affector ColourFader
    {
        red -0.5
        green -1.2
        blue -1.0
        alpha -1.8
    }
    affector Scaler
    {
        rate 3
    }
}
particle_system CR/M16/Nozzle
{
    material CR_FX/Bloom
    particle_width 8
    particle_height 8
    quota 18
    cull_each true
    sorted false
    local_space false
    billboard_type point
    emitter Point
    {
        angle 0
        emission_rate 0
        time_to_live_min 0.08
        time_to_live_max 0.13
        direction 0 -1 0
        velocity 0.5
        colour_range_start 0.65 0.95 1 0.8
        colour_range_end 0.2 0.6 1 0.6
    }
    affector ColourFader
    {
        alpha -6
    }
}
particle_system CR/M16/PadDust
{
    material CR_FX/Dust
    particle_width 7
    particle_height 4
    quota 240
    cull_each true
    sorted true
    local_space false
    billboard_type point
    emitter Box
    {
        width 10
        height 0.4
        depth 10
        angle 82
        emission_rate 0
        time_to_live_min 1.8
        time_to_live_max 3.2
        direction 0 1 0
        velocity_min 10
        velocity_max 22
        colour_range_start 0.48 0.32 0.17 0.3
        colour_range_end 0.68 0.46 0.25 0.18
    }
    affector LinearForce
    {
        force_vector 0 -1 0
        force_application add
    }
    affector Scaler
    {
        rate 5
    }
    affector ColourFader
    {
        alpha -0.11
    }
}
