import * from "CR_BZBase.material"

material crnvcr : CR_BZBase
{
    set_texture_alias DiffuseMap crnvcr_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crnvcr_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material cramcr : CR_BZBase
{
    set_texture_alias DiffuseMap crpkcr0_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crpkcr0_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".15 .15 .15"
    set $shininess "32"
}

