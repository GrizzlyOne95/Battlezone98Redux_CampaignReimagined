import * from "CR_BZBase.material"

material svcnst00 : CR_BZBase
{
	set_texture_alias DiffuseMap svcnst_d.dds
	set_texture_alias NormalMap svcnst_N.dds
	set_texture_alias SpecularMap svcnst_S.dds
	set_texture_alias EmissiveMap svcnst_e.dds
	set_texture_alias ACTMap svcnst00_ACT.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}


material svcnst_nacjet : CR_BZBase
{
	set_texture_alias DiffuseMap svcnst_nacjet_D.dds
	set_texture_alias NormalMap svcnst_nacjet_N.dds
	set_texture_alias SpecularMap svcnst_nacjet_S.dds
	set_texture_alias EmissiveMap svcnst_nacjet_E.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}
