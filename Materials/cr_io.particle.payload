// cr_io.particle
//
// Ogre particle templates for the Io weather director (CRIoWeather.lua).
//
// World-placed systems, streamed in and out around the players: red fog and a
// faint glow over lava pools, smoke plumes with an eruption burst at every
// geyser, the glowing core and thrown spatter of an eruption, and the dust a
// quake shakes loose (camera-attached). Ash fall, haze and grit are NOT here:
// the presets and the ash layer must work without this opt-in payload, so
// CR/Io/Haze, CR/Io/Grit and CR/Io/AshFall live in cr_weather.particle.payload.
//
// The materials are CRIo/* in crart_io.material: CR_reactive's art on a pass
// DX11 draws natively, so every colour here draws as written (the CR_FX/*
// originals swap red and blue on DX11). No new art. Docs/IO_WEATHER.md lists
// which ones would improve with a dedicated texture.
//
// Axis note for Box emitters (Ogre AreaEmitter): `direction` is the DEPTH axis.
// With direction 0 1 0, depth runs vertically and width/height are horizontal.
// With a horizontal direction, `height` becomes the thin vertical axis, which is
// what the flat fog sheets rely on. (Same convention as cr_venus.particle.)
//
// Emitter and affector ORDER MATTERS: CRIoWeather addresses both by index.

// =============================================================================
// Lava fog -- a low, red, glowing sheet over the molten pools
// =============================================================================

//   emitter 0  Box sheet
//   affector 0 ColourInterpolator   (fade in over the first fifth, fade out at the end)
//   affector 1 Scaler
//   affector 2 LinearForce          (live wind from the director)
//   affector 3 DirectionRandomiser
particle_system CR/Io/LavaFog
{
    material            CRIo/Haze
    particle_width      54.0
    particle_height     54.0
    quota               70
    cull_each           true
    sorted              true
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               30
        emission_rate       2.4
        time_to_live_min    16.0
        time_to_live_max    26.0
        direction           1 0 0.4
        velocity_min        0.2
        velocity_max        0.9
        colour_range_start  0.86 0.24 0.07 0.00
        colour_range_end    0.70 0.16 0.05 0.00
        width               110
        height              6
        depth               110
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 0.86 0.24 0.07 0.00
        time1   0.20
        colour1 0.90 0.26 0.07 0.24
        time2   0.75
        colour2 0.74 0.17 0.05 0.19
        time3   1.00
        colour3 0.42 0.08 0.03 0.00
    }

    affector Scaler
    {
        rate 1.0
    }

    affector LinearForce
    {
        force_vector        0 0 0
        force_application   add
    }

    affector DirectionRandomiser
    {
        randomness  2
        scope       0.3
        keep_velocity true
    }
}

// The additive half of the same pool: a very faint orange bloom that breathes.
// The director pulses its rate with a slow sine, so the lava seems to light the
// air above it.
//   emitter 0  Box sheet
//   affector 0 ColourInterpolator
//   affector 1 Scaler
particle_system CR/Io/LavaGlow
{
    material            CRIo/Bloom
    particle_width      46.0
    particle_height     46.0
    quota               40
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               20
        emission_rate       0.7
        time_to_live_min    7.0
        time_to_live_max    12.0
        direction           1 0 0.3
        velocity_min        0.1
        velocity_max        0.5
        colour_range_start  1.00 0.34 0.07 0.00
        colour_range_end    0.96 0.26 0.05 0.00
        width               100
        height              4
        depth               100
    }

    affector ColourInterpolator
    {
        time0   0.00
        colour0 1.00 0.34 0.07 0.00
        time1   0.30
        colour1 1.00 0.34 0.07 0.10
        time2   0.70
        colour2 0.96 0.26 0.05 0.08
        time3   1.00
        colour3 0.80 0.16 0.03 0.00
    }

    affector Scaler
    {
        rate 0.8
    }
}

// =============================================================================
// Volcanic vents
// =============================================================================

//   emitter 0  steady sulphur-grey wisp
//   emitter 1  eruption column (rate driven by the director)
//   affector 0 Scaler
//   affector 1 ColourFader
//   affector 2 LinearForce          (live wind)
//   affector 3 Rotator
particle_system CR/Io/Plume
{
    material            CRIo/SmokeHeavy
    particle_width      16.0
    particle_height     16.0
    quota               300
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               9
        emission_rate       4
        time_to_live_min    7.0
        time_to_live_max    12.0
        direction           0 1 0
        velocity_min        7
        velocity_max        12
        colour_range_start  0.62 0.54 0.30 0.42
        colour_range_end    0.40 0.34 0.22 0.00
    }

    emitter Point
    {
        angle               17
        emission_rate       0
        time_to_live_min    6.0
        time_to_live_max    10.0
        direction           0 1 0
        velocity_min        28
        velocity_max        48
        colour_range_start  0.22 0.15 0.12 0.82
        colour_range_end    0.40 0.26 0.17 0.00
    }

    affector Scaler
    {
        rate 3.0
    }

    affector ColourFader
    {
        alpha -0.06
    }

    affector LinearForce
    {
        force_vector        0 0 0
        force_application   add
    }

    affector Rotator
    {
        rotation_speed_range_start  -25
        rotation_speed_range_end     25
        rotation_range_start          0
        rotation_range_end          360
    }
}

// The glowing core of an eruption: additive, short-lived, bright at the vent
// mouth and fading as it climbs. Created only while something is erupting.
//   emitter 0  column core
//   emitter 1  base flare
particle_system CR/Io/PlumeGlow
{
    material            CRIo/Bloom
    particle_width      11.0
    particle_height     11.0
    quota               180
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               8
        emission_rate       0
        time_to_live_min    1.2
        time_to_live_max    2.6
        direction           0 1 0
        velocity_min        12
        velocity_max        26
        colour_range_start  1.00 0.64 0.20 0.55
        colour_range_end    0.92 0.30 0.07 0.25
    }

    emitter Point
    {
        angle               70
        emission_rate       0
        time_to_live_min    0.5
        time_to_live_max    1.1
        direction           0 1 0
        velocity_min        1
        velocity_max        6
        colour_range_start  1.00 0.52 0.12 0.80
        colour_range_end    0.90 0.24 0.05 0.40
    }

    affector Scaler
    {
        rate 4.5
    }

    affector ColourFader
    {
        red     -0.10
        green   -0.35
        blue    -0.20
        alpha   -0.55
    }
}

// Lava spatter thrown by an eruption. Gravity pulls it back down so the burst
// reads as thrown rather than floating.
particle_system CR/Io/Spatter
{
    material            CRIo/Ember
    particle_width      1.7
    particle_height     1.7
    quota               130
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Point
    {
        angle               40
        emission_rate       0
        time_to_live_min    2.6
        time_to_live_max    5.0
        direction           0 1 0
        velocity_min        22
        velocity_max        46
        colour_range_start  1.00 0.58 0.18 0.95
        colour_range_end    0.72 0.20 0.05 0.60
    }

    affector LinearForce
    {
        force_vector        0 -16 0
        force_application   add
    }

    affector ColourFader
    {
        red     -0.16
        green   -0.30
        blue    -0.08
        alpha   -0.20
    }
}

// =============================================================================
// Quake dust -- grit shaken out of the air and the ground
// =============================================================================

// Camera-attached. The director raises the rate with the quake envelope, so the
// dust arrives with the shake and settles after it.
particle_system CR/Io/QuakeDust
{
    material            CRIo/Dust
    particle_width      3.2
    particle_height     3.2
    quota               700
    cull_each           true
    sorted              false
    local_space         false
    billboard_type      point

    emitter Box
    {
        angle               24
        emission_rate       0
        time_to_live_min    1.6
        time_to_live_max    3.4
        direction           0 -1 0
        velocity_min        4
        velocity_max        12
        colour_range_start  0.64 0.44 0.28 0.55
        colour_range_end    0.46 0.30 0.20 0.28
        width               150
        height              150
        depth               36
    }

    affector ColourFader
    {
        alpha -0.15
    }

    affector Rotator
    {
        rotation_speed_range_start  -90
        rotation_speed_range_end     90
        rotation_range_start          0
        rotation_range_end          360
    }
}
