import * from "CR_BZBase.material"

material cr16hng : CR_BZBase
{
    set_texture_alias DiffuseMap cr16hng_d.dds
    set_texture_alias NormalMap cr16hng_n.dds
    set_texture_alias SpecularMap cr16hng_s.dds
    set_texture_alias EmissiveMap cr16hng_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".7 .7 .7"
    set $shininess "127"
}
