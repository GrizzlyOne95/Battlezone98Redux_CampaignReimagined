import * from "CR_BZBase.material"

material avcnst00 : CR_BZBase
{
	set_texture_alias DiffuseMap avcnst_D.dds
	set_texture_alias NormalMap avcnst_N.dds
	set_texture_alias SpecularMap avcnst_S.dds
	set_texture_alias EmissiveMap avcnst_E.dds
	set_texture_alias ACTMap avcnst00_ACT.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}


material avcnst_nacjet : CR_BZBase
{
	set_texture_alias DiffuseMap avcnst_nacjet_D.dds
	set_texture_alias NormalMap avcnst_nacjet_N.dds
	set_texture_alias SpecularMap avcnst_nacjet_S.dds
	set_texture_alias EmissiveMap avcnst_nacjet_E.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}
