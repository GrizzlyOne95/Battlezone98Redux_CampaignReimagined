import * from "BZBase.material"
material crcred200 : BZBase
{
    set_texture_alias DiffuseMap crcred2_d.dds
    set_texture_alias NormalMap crcred2_n.dds
    set_texture_alias SpecularMap crcred2_s.dds
    set_texture_alias EmissiveMap crcred2_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".6 .6 .6"
    set $shininess "100"
    set $glow "1 1 1"
}
