import * from "bbhqcp.material"

material CRV/Building/bdhqwall : bbhqcp00
{
    set_texture_alias DiffuseMap crvbdhqwall_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvbdhqwall_e.dds
}

material CRV/Building/bdhqctrl : bbhqcp00
{
    set_texture_alias DiffuseMap crvbdhqctrl_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvbdhqctrl_e.dds
}
