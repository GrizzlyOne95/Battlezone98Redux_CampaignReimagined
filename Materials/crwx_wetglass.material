// Generated by tools/wetglassgen.py in ISDF Chronicles (ported to CRWX_ names); edit there, not here.
// Wet-glass rain overlay drawn by CRWetGlass.lua; A<n> is opacity n/16.

material CRWX_WetBeads_A1
{
	// Masked to the cockpit glass (crwx_wetglass.hlsl): SM4 for DX11, SM3 for
	// DX9. CRWetGlass.lua swaps texture unit 1 of both for the craft's mask.
	technique
	{
		pass
		{
			vertex_program_ref CRWX_WetGlass_vertex_SM4
			{
			}
			fragment_program_ref CRWX_WetGlass_fragment_SM4
			{
				param_named opacity float 0.0625
			}
			scene_blend alpha_blend
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			texture_unit
			{
				texture crwx_wetbeads.png
				filtering linear linear linear
			}
			texture_unit
			{
				texture crwx_wetmask_open.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}

	technique
	{
		pass
		{
			vertex_program_ref CRWX_WetGlass_vertex_SM3
			{
			}
			fragment_program_ref CRWX_WetGlass_fragment_SM3
			{
				param_named opacity float 0.0625
			}
			scene_blend alpha_blend
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			texture_unit
			{
				texture crwx_wetbeads.png
				filtering linear linear linear
			}
			texture_unit
			{
				texture crwx_wetmask_open.png
				tex_address_mode clamp
				filtering linear linear none
			}
		}
	}

	// Unmasked fixed-function fallback.
	technique
	{
		pass
		{
			lighting off
			fog_override true
			scene_blend alpha_blend
			depth_check off
			depth_write off
			cull_hardware none
			cull_software none
			texture_unit
			{
				texture crwx_wetbeads.png
				filtering linear linear linear
				alpha_op_ex modulate src_texture src_manual 0.0625
			}
		}
	}
}

