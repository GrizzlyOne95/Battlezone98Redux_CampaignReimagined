import * from "CR_BZBase.material"

material cvslf : CR_BZBase
{
	set_texture_alias DiffuseMap cvslf_d.dds
	set_texture_alias NormalMap cvslf_N.dds
	set_texture_alias SpecularMap cvslf_S.dds
	set_texture_alias EmissiveMap cvslf_e.dds
	set_texture_alias ACTMap cvslf_ACT.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}


material cvslf_nacjet : CR_BZBase
{
	set_texture_alias DiffuseMap cvslf_nacjet_D.dds
	set_texture_alias NormalMap cvslf_nacjet_N.dds
	set_texture_alias SpecularMap cvslf_nacjet_S.dds
	set_texture_alias EmissiveMap cvslf_nacjet_E.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}
