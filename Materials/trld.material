import * from "CR_BZBase.material"
material trld00 : CR_BZBase
{
 set_texture_alias DiffuseMap trld_d.dds
 set_texture_alias NormalMap trld_N.dds
 set_texture_alias SpecularMap black.dds
 set_texture_alias EmissiveMap black.dds
 set_texture_alias ACTMap trld00_ACT.dds
 set $diffuse "1 1 1"
 set $ambient "1 1 1"
 set $specular ".15 .15 .15"
 set $shininess "32"
}
