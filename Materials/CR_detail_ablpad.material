import * from "ablpad.material"

material CRV/Building/nsdeck : ablpad
{
    set_texture_alias DiffuseMap crvnsdeck_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crvnsdeck_e.dds
}

material CRV/Building/nswall : ablpad
{
    set_texture_alias DiffuseMap crvnswall_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap black.dds
}
