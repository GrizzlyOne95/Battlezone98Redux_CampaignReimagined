import * from "CR_BZBase.material"

material CRV/cvwalkHeadHull : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap cvwalk_d.dds
    set_texture_alias NormalMap cvwalk_N.dds
    set_texture_alias SpecularMap cvwalk_S.dds
    set_texture_alias EmissiveMap cvwalk_e.dds
}

material CRV/cvwalkSectionBacks : CR_BZBaseCockpit
{
    set_texture_alias DiffuseMap crvchcp_d.dds
    set_texture_alias NormalMap crvchcp_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap capblack_E.dds
}
