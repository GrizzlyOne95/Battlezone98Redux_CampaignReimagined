import * from "CR_BZBase.material"

material cvfigh : CR_BZBase
{
	set_texture_alias DiffuseMap cvfigh_d.dds
	set_texture_alias NormalMap cvfigh_N.dds
	set_texture_alias SpecularMap cvfigh_S.dds
	set_texture_alias EmissiveMap cvfigh_e.dds
	set_texture_alias ACTMap cvfigh_ACT.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}


material cvfigh01 : CR_BZBaseCockpit
{
	set_texture_alias DiffuseMap chinese_units_cockpit_d.dds
	set_texture_alias NormalMap chinese_units_cockpit_n.dds
	set_texture_alias SpecularMap chinese_units_cockpit_S.dds
	set_texture_alias EmissiveMap chinese_units_cockpit_e.dds
	set_texture_alias ACTMap cvfigh01_ACT.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}


material cvfigh_nacjet : CR_BZBase
{
	set_texture_alias DiffuseMap cvfigh_nacjet_D.dds
	set_texture_alias NormalMap cvfigh_nacjet_N.dds
	set_texture_alias SpecularMap cvfigh_nacjet_S.dds
	set_texture_alias EmissiveMap cvfigh_nacjet_E.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}
