import * from "CR_BZBase.material"

material avsav00 : CR_BZBase
{
    set_texture_alias DiffuseMap avsav_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap avsav_s.dds
    set_texture_alias EmissiveMap avsav_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".7 .7 .7"
    set $shininess "127"
}
