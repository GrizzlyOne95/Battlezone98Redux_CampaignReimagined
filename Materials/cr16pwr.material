import * from "CR_BZBase.material"

material cr16pwr : CR_BZBase
{
    set_texture_alias DiffuseMap cr16pwr_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap sbspow_S.dds
    set_texture_alias EmissiveMap sbspow_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".7 .7 .7"
    set $shininess "127"
}
