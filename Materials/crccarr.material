import * from "BZBase.material"
material crccarr00 : BZBase
{
    set_texture_alias DiffuseMap crccarr_d.dds
    set_texture_alias NormalMap crccarr_n.dds
    set_texture_alias SpecularMap crccarr_s.dds
    set_texture_alias EmissiveMap crccarr_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".6 .6 .6"
    set $shininess "100"
    set $glow "1 1 1"
}
