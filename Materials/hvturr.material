import * from "CR_BZBase.material"

material hvturr00 : CR_BZBase
{
	set_texture_alias DiffuseMap hvturr00_D.dds
	set_texture_alias SpecularMap hvturr00_S.dds
	set_texture_alias EmissiveMap hvturr00_E.dds

	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
}
