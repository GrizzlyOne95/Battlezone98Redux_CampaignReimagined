// Achilles sky dome. Technique 0 is the CR_AchillesSky look (Shaders/CR_achillessky.hlsl,
// DX11/DX9); technique 1 keeps the stock achilles.tga dome for OpenGL. Both start
// with achilles.tga on unit 0 so the dome's own texture lookups stay valid.
// CRWorldArt.UpdateSky writes the sun direction, clarity, the jungle storm and
// rain, the lightning and Uranus's direction into the technique 0 pass colours
// every frame.
material CRSKYAC.MAP
{
	technique 0
	{
		pass 0
		{
			vertex_program_ref CR_AchillesSky_vertex
			{
			}
			fragment_program_ref CR_AchillesSky_fragment
			{
			}
			lighting off
			scene_blend one zero
			depth_write off
			// A high sun, fair weather and Uranus where the stock Achilles maps
			// put it (heading 210, 30 degrees up) until the first UpdateSky
			// write, so the dome still draws when CR's Lua is not running.
			specular 0 0.36 0.80 0.48 0
			emissive 0 1 0 0
			diffuse 0 1 0 0
			ambient -0.433 0.5 0.75 1
			texture_unit 0
			{
				texture achilles.tga
			}
			texture_unit 1
			{
				texture crsky_achilles_clouds.png
				tex_address_mode wrap
				filtering trilinear
			}
			texture_unit 2
			{
				texture crsky_uranus.png
				tex_address_mode wrap clamp
				filtering trilinear
			}
			texture_unit 3
			{
				texture crsky_uranus_rings.png
				tex_address_mode clamp
				filtering trilinear
			}
		}
	}
	technique 1
	{
		pass 0
		{
			vertex_program_ref CR_SkyDome_vertex
			{
			}
			fragment_program_ref CR_WorldSky_fragment
			{
				param_named horizonBlend float4 .02 .35 1 0
			}
			lighting off
			scene_blend one zero
			depth_write off
			texture_unit
			{
				texture achilles.tga
			}
		}
	}
}
