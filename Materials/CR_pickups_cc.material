import * from "CR_BZBase.material"

material crnvcc : CR_BZBase
{
    set_texture_alias DiffuseMap crnvcc_d.dds
    set_texture_alias NormalMap crnvcc_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crnvcc_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material cramcc : CR_BZBase
{
    set_texture_alias DiffuseMap crpkcc0_d.dds
    set_texture_alias NormalMap crpkcc0_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crpkcc0_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".15 .15 .15"
    set $shininess "32"
}

