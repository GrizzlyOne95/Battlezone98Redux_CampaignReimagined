import * from "CR_BZBase.material"

material crnvbd : CR_BZBase
{
    set_texture_alias DiffuseMap crnvbd_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crnvbd_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material crambd : CR_BZBase
{
    set_texture_alias DiffuseMap crpkbd0_d.dds
    set_texture_alias NormalMap flat_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap black.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material crambd/plain : crambd
{
    set_texture_alias DiffuseMap crpkbd0_surf.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
}

