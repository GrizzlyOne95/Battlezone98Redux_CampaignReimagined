import * from "CR_BZBase.material"

material crnvbd : CR_BZBase
{
    set_texture_alias DiffuseMap crnvbd_d.dds
    set_texture_alias NormalMap crnvbd_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crnvbd_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".25 .25 .25"
    set $shininess "48"
}

material crambd : CR_BZBase
{
    set_texture_alias DiffuseMap crpkbd0_d.dds
    set_texture_alias NormalMap crpkbd0_N.dds
    set_texture_alias SpecularMap crvcca_patch_s.dds
    set_texture_alias EmissiveMap crpkbd0_e.dds
    set $diffuse "1 1 1"
    set $ambient "1 1 1"
    set $specular ".15 .15 .15"
    set $shininess "32"
}

