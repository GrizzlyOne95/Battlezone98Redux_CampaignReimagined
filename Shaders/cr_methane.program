// Campaign Reimagined: Titan liquid-methane surface (Shaders/cr_methane.hlsl).
// DX11 (SM4) and DX9 (SM3) delegates only; there is no GLSL twin, so on OpenGL
// the unified programs have no supported delegate and Materials/cr_methane.material
// falls through to its invisible technique. Every default_params entry below names a
// constant the compiler keeps (Tools/Test-MethaneShader.ps1 checks this with fxc).
//
// The pass diffuse and specular colours carry the director's controls, not colours, so the
// light colours are the raw power-scaled ones: the derived_* variants multiply by the pass
// colours and would tint every light by them (seen live: a red glint on green liquid).

vertex_program CR_Methane_vertex_HLSL4 hlsl
{
	source cr_methane.hlsl
	target vs_4_0
	entry_point methane_vertex
	preprocessor_defines SM4=1
}

vertex_program CR_Methane_vertex_HLSL hlsl
{
	source cr_methane.hlsl
	target vs_3_0
	entry_point methane_vertex
}

vertex_program CR_Methane_vertex unified
{
	delegate CR_Methane_vertex_HLSL4
	delegate CR_Methane_vertex_HLSL
	default_params
	{
		param_named_auto wvpMat worldviewproj_matrix
		param_named_auto worldViewMat worldview_matrix
	}
}

fragment_program CR_Methane_fragment_HLSL4 hlsl
{
	source cr_methane.hlsl
	target ps_4_0
	entry_point methane_fragment
	preprocessor_defines SM4=1
}

fragment_program CR_Methane_fragment_HLSL hlsl
{
	source cr_methane.hlsl
	target ps_3_0
	entry_point methane_fragment
}

fragment_program CR_Methane_fragment unified
{
	delegate CR_Methane_fragment_HLSL4
	delegate CR_Methane_fragment_HLSL
	default_params
	{
		param_named_auto fogColour fog_colour
		param_named_auto fogParams fog_params
		param_named_auto sceneAmbient derived_ambient_light_colour
		param_named_auto lightDiffuse light_diffuse_colour_power_scaled_array 8
		param_named_auto lightSpecular light_specular_colour_power_scaled_array 8
		param_named_auto lightPosition light_position_view_space_array 8
		param_named_auto lightAttenuation light_attenuation_array 8
		param_named_auto spotLightParams spotlight_params_array 8
		param_named_auto lightDirection light_direction_view_space_array 8
		param_named_auto lightCount light_count
		param_named_auto viewMat view_matrix
		param_named_auto time time
		param_named_auto methaneControl surface_diffuse_colour
		param_named_auto methaneSun surface_specular_colour
		param_named methaneExtent float4 5120 5120 0.3 0.7
		param_named methaneBody float4 0.3 0.19 0.08 0.55
		param_named methaneSky float4 0.56 0.33 0.12 1
		param_named methaneSurface float4 0.5 0.06 0.02 120
		param_named methaneWaves float4 7 19 0.35 0.6
		param_named methaneGlare float4 1 0.72 0.4 10
		param_named methaneGlint float4 260 1.4 1.6 0.9
	}
}
