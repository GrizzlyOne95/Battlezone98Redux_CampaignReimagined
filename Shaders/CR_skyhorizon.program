vertex_program CR_Horizon_vertex unified
{
 delegate CR_Horizon_vertexGLSL
 delegate CR_Horizon_vertexHLSL4
 delegate CR_Horizon_vertexHLSL
 default_params
 {
  param_named_auto wvpMat worldviewproj_matrix
  param_named_auto worldMat world_matrix
  param_named_auto cameraPosition camera_position_object_space
 }
}

fragment_program CR_Horizon_fragment unified
{
 delegate CR_Horizon_fragmentGLSL
 delegate CR_Horizon_fragmentHLSL4
 delegate CR_Horizon_fragmentHLSL
 default_params
 {
  param_named_auto fogColour fog_colour
  param_named_auto fogParams fog_params
  param_named horizonBlend float4 0.005 0.12 1 0
 }
}
