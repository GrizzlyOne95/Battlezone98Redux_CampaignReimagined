// Campaign Reimagined - DX11 Enhanced Material V2 object permutations.
//
// CR_MATERIAL_V2 reinterprets the existing t2/specular sample as explicit
// material DATA: RGB = linear F0, A = perceptual roughness. Separate programs
// keep the legacy path branch-free and sample-identical. Non-DX11 delegates
// intentionally fall back to the established Enhanced/compatibility programs.

fragment_program CR_BaseMaterialV2HighNoShadow_fragmentHLSL4 hlsl
{
    source CR_base-sm4.hlsl
    target ps_4_0
    entry_point base_fragment
    preprocessor_defines MAX_LIGHTS=24,NORMALMAP_ENABLED=1,SPECULARMAP_ENABLED=1,EMISSIVEMAP_ENABLED=1,ENHANCED_MODE=1,IBL_ENABLED=1,CR_LINEAR_LIGHT=1,CR_RADIAL_FOG=1,CR_MATERIAL_V2=1

    default_params
    {
        param_named_auto inverseViewMatrix inverse_view_matrix
    }
}

fragment_program CR_BaseMaterialV2HighShadow_fragmentHLSL4 hlsl
{
    source CR_base-sm4.hlsl
    target ps_4_0
    entry_point base_fragment
    preprocessor_defines MAX_LIGHTS=24,SHADOWRECEIVER=1,PCF_SIZE=4,NORMALMAP_ENABLED=1,SPECULARMAP_ENABLED=1,EMISSIVEMAP_ENABLED=1,ENHANCED_MODE=1,IBL_ENABLED=1,CR_LINEAR_LIGHT=1,CR_RADIAL_FOG=1,CR_MATERIAL_V2=1

    default_params
    {
        param_named_auto inverseViewMatrix inverse_view_matrix
    }
}

