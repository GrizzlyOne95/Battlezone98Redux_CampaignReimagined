fragment_program CR_BaseMaterialV2HighNoShadow_fragment unified
{
    delegate CR_BaseMaterialV2HighNoShadow_fragmentHLSL4
    delegate CR_BaseENHighNoShadow_fragmentGLSLES
    delegate CR_BaseENHighNoShadow_fragmentGLSL
    delegate CR_BaseENHighNoShadow_fragmentHLSL

    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto diffuseColor surface_diffuse_colour
        param_named_auto materialShininess surface_shininess
        param_named_auto materialEmissive surface_emissive_colour
        param_named_auto lightDiffuse derived_light_diffuse_colour_array 24
        param_named_auto lightSpecular derived_light_specular_colour_array 24
        param_named_auto lightAttenuation light_attenuation_array 24
        param_named_auto spotLightParams spotlight_params_array 24
        param_named_auto lightPosition light_position_view_space_array 24
        param_named_auto lightDirection light_direction_view_space_array 24
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
        param_named_auto lightCount light_count
        param_named transparency float 0.0
    }
}

