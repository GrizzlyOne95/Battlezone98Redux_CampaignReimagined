// Campaign Reimagined - DX11 Legacy-PBR Phase 2: Static IBL
//
// These wrappers deliberately put the new SM4 IBL program first, then fall back
// to the existing Enhanced delegates on non-DX11 render systems. This keeps DX9,
// GLSL, GLSLES, Retro, and the lower Enhanced quality tiers unchanged.

// -----------------------------------------------------------------------------
// Base/object DX11 SM4 programs
// -----------------------------------------------------------------------------

fragment_program CR_BaseIBLHighNoShadow_fragmentHLSL4 hlsl
{
    source CR_base-sm4.hlsl
    target ps_4_0
    entry_point base_fragment
    preprocessor_defines MAX_LIGHTS=24,NORMALMAP_ENABLED,SPECULARMAP_ENABLED,EMISSIVEMAP_ENABLED,ENHANCED_MODE,IBL_ENABLED,CR_LINEAR_LIGHT=1

    default_params
    {
        param_named_auto inverseViewMatrix inverse_view_matrix
    }
}

fragment_program CR_BaseIBLHighShadow_fragmentHLSL4 hlsl
{
    source CR_base-sm4.hlsl
    target ps_4_0
    entry_point base_fragment
    preprocessor_defines MAX_LIGHTS=24,SHADOWRECEIVER,PCF_SIZE=4,NORMALMAP_ENABLED,SPECULARMAP_ENABLED,EMISSIVEMAP_ENABLED,ENHANCED_MODE,IBL_ENABLED,CR_LINEAR_LIGHT=1

    default_params
    {
        param_named_auto inverseViewMatrix inverse_view_matrix
    }
}

fragment_program CR_BaseIBLHighPSSM_fragmentHLSL4 hlsl
{
    source CR_base-sm4.hlsl
    target ps_4_0
    entry_point base_fragment
    preprocessor_defines MAX_LIGHTS=24,SHADOWRECEIVER,PSSM_ENABLED,PCF_SIZE=4,NORMALMAP_ENABLED,SPECULARMAP_ENABLED,EMISSIVEMAP_ENABLED,ENHANCED_MODE,IBL_ENABLED,CR_LINEAR_LIGHT=1

    default_params
    {
        param_named_auto inverseViewMatrix inverse_view_matrix
    }
}

fragment_program CR_BaseIBLHighNoShadow_fragment unified
{
    delegate CR_BaseIBLHighNoShadow_fragmentHLSL4
    delegate CR_BaseENHighNoShadow_fragmentGLSLES
    delegate CR_BaseENHighNoShadow_fragmentGLSL
    delegate CR_BaseENHighNoShadow_fragmentHLSL

    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto diffuseColor surface_diffuse_colour
        param_named_auto materialShininess surface_shininess
        param_named_auto materialEmissive surface_emissive_colour
        param_named_auto lightDiffuse derived_light_diffuse_colour_array 24
        param_named_auto lightSpecular derived_light_specular_colour_array 24
        param_named_auto lightAttenuation light_attenuation_array 24
        param_named_auto spotLightParams spotlight_params_array 24
        param_named_auto lightPosition light_position_view_space_array 24
        param_named_auto lightDirection light_direction_view_space_array 24
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
        param_named_auto lightCount light_count
        param_named transparency float 0.0
    }
}

fragment_program CR_BaseIBLHighShadow_fragment unified
{
    delegate CR_BaseIBLHighShadow_fragmentHLSL4
    delegate CR_BaseENHighShadow_fragmentGLSLES
    delegate CR_BaseENHighShadow_fragmentGLSL
    delegate CR_BaseENHighShadow_fragmentHLSL

    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto diffuseColor surface_diffuse_colour
        param_named_auto materialShininess surface_shininess
        param_named_auto materialEmissive surface_emissive_colour
        param_named_auto lightDiffuse derived_light_diffuse_colour_array 24
        param_named_auto lightSpecular derived_light_specular_colour_array 24
        param_named_auto lightAttenuation light_attenuation_array 24
        param_named_auto spotLightParams spotlight_params_array 24
        param_named_auto lightPosition light_position_view_space_array 24
        param_named_auto lightDirection light_direction_view_space_array 24
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
        param_named_auto invShadowMapSize1 inverse_texture_size 4
        param_named_auto lightCount light_count
        param_named transparency float 0.0
    }
}

fragment_program CR_BaseIBLHighPSSM_fragment unified
{
    delegate CR_BaseIBLHighPSSM_fragmentHLSL4
    delegate CR_BaseENHighPSSM_fragmentGLSLES
    delegate CR_BaseENHighPSSM_fragmentGLSL
    delegate CR_BaseENHighPSSM_fragmentHLSL

    default_params
    {
        param_named_auto sceneAmbient derived_ambient_light_colour
        param_named_auto diffuseColor surface_diffuse_colour
        param_named_auto materialShininess surface_shininess
        param_named_auto materialEmissive surface_emissive_colour
        param_named_auto lightDiffuse derived_light_diffuse_colour_array 24
        param_named_auto lightSpecular derived_light_specular_colour_array 24
        param_named_auto lightAttenuation light_attenuation_array 24
        param_named_auto spotLightParams spotlight_params_array 24
        param_named_auto lightPosition light_position_view_space_array 24
        param_named_auto lightDirection light_direction_view_space_array 24
        param_named_auto fogColour fog_colour
        param_named_auto fogParams fog_params
        param_named_auto invShadowMapSize1 inverse_texture_size 4
        param_named_auto invShadowMapSize2 inverse_texture_size 5
        param_named_auto invShadowMapSize3 inverse_texture_size 6
        param_named pssmSplitPoints float4 0.1 16.0 64.0 256.0
        param_named_auto lightCount light_count
        param_named transparency float 0.0
    }
}

