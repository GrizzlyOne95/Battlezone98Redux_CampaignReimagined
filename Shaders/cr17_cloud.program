// Storm cloud deck for CRJungle17's sky plane. Delegates precede the unified
// programs: Ogre binds unified default_params only against delegates already
// parsed, and an unbound wvpMat draws nothing.

vertex_program CR17_Cloud_vertexHLSL4_art_cf130466d6 hlsl
{
    source cr17_cloud-sm4.hlsl
    target vs_4_0
    entry_point cloud_vertex
}

vertex_program CR17_Cloud_vertexHLSL_art_0e39924744 hlsl
{
    source cr17_cloud.hlsl
    target vs_3_0
    entry_point cloud_vertex
}

vertex_program CR17_Cloud_vertexGLSL_art_c11682aa84 glsl
{
    source cr17_cloud-vertex.glsl
    syntax glsl120
}

fragment_program CR17_Cloud_fragmentHLSL4_art_cf130466d6 hlsl
{
    source cr17_cloud-sm4.hlsl
    target ps_4_0
    entry_point cloud_fragment
}

fragment_program CR17_Cloud_fragmentHLSL_art_0e39924744 hlsl
{
    source cr17_cloud.hlsl
    target ps_3_0
    entry_point cloud_fragment
}

fragment_program CR17_Cloud_fragmentGLSL_art_e816b4db2e glsl
{
    source cr17_cloud-fragment.glsl
    syntax glsl120
    default_params
    {
        param_named diffuseMap int 0
    }
}

vertex_program CR17_Cloud_vertex unified
{
    delegate CR17_Cloud_vertexGLSL_art_c11682aa84
    delegate CR17_Cloud_vertexHLSL4_art_cf130466d6
    delegate CR17_Cloud_vertexHLSL_art_0e39924744
    default_params
    {
        param_named_auto wvpMat worldviewproj_matrix
        param_named_auto texMat texture_matrix 0
    }
}

fragment_program CR17_Cloud_fragment unified
{
    delegate CR17_Cloud_fragmentGLSL_art_e816b4db2e
    delegate CR17_Cloud_fragmentHLSL4_art_cf130466d6
    delegate CR17_Cloud_fragmentHLSL_art_0e39924744
    default_params
    {
        param_named_auto fogColour fog_colour
        param_named tint float4 0.55 0.58 0.6 0.45
        param_named horizonBlend float4 0.015 0.14 1 0
    }
}
