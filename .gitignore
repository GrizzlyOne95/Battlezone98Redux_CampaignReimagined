# Ignore unexpected runtime-flat root files by default
/*

# Allow GitHub automation and documentation
!/.github/
!/.github/**
!/docs/
!/docs/**
!/Docs/
!/Docs/**

# Allow source tree
!/_Source/

# Allow organized source folders
!/Assets/
!/Bin/
!/Config/
!/InstallerPayload/
!/InstallerPayload/**
!/flags/
!/Materials/
!/Missions/
!/ODF/
!/OverlayFont/
!/References/
!/Scripts/
!/Shaders/
!/Text/
!/Tools/
/Tools/*
!/Tools/Test-DX11ShaderValidator.ps1
!/Tools/Set-TerrainNormalDiagnostic.ps1
!/Tools/Test-EnhancedPssmV2.ps1
!/Tools/Set-EnhancedPssmVersion.ps1

# Intentional root files
!/.gitignore
!/AGENTS.md
!/CHANGELOG.md
!/Manage-CampaignFiles.ps1
!/README.md
!/workshop.config.example.json
!/install/
!/install/install_windows.ps1
!/install.des
!/update.des
!/staged.des
!/nocopy.des

# Local machine/generated artifacts live under Local and stay ignored
/Local/

# Ignore system files
thumbs.db
desktop.ini

# Ignore specific generated files inside tracked folders
/Config/fix_locations.csv
/Text/need_defs.txt
/Text/OgreMain.dumpbin.exports.txt

# Generated interior-capped chunk meshes. Reproducible from Assets/chunkMeshes
# via Tools/Cap-ChunkMeshes.py; see docs/CHUNK_MESH_INTERIOR_CAPS.md. When absent,
# Manage-CampaignFiles.ps1 deploys the authored meshes instead.
/Assets/chunkMeshes_capped/
