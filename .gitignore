# Ignore unexpected runtime-flat root files by default
/*

# Allow GitHub automation and documentation
!/.github/
!/.github/**
!/docs/
!/docs/**
!/Docs/
!/Docs/**

# Allow source tree
!/_Source/

# Allow organized source folders
!/Assets/
!/Bin/
!/Config/
!/InstallerPayload/
!/InstallerPayload/**
!/flags/
!/Materials/
!/Missions/
!/ODF/
!/OverlayFont/
!/References/
!/Scripts/
!/Shaders/
# The shipping lock must be committed: its diff is how a change to what players
# receive gets reviewed. Regenerate with Manage-CampaignFiles.ps1 -bless.
!/Shipping/
!/Shipping/**
!/Text/
# Tools are source. Do not use a deny-all/whitelist here: new validators and
# maintenance scripts must appear in git status instead of being silently hidden.
!/Tools/

# OpenShim-owned files the lock ships, committed so a clean checkout is complete.
# Pinned to the commit in openshim/OPENSHIM_PIN.txt; refresh with Manage-CampaignFiles.ps1 -refresh-natives.
# Only these paths: the rest of BZ_ASSETS_CORE is the game's own content, not ours.
!/openshim/
!/openshim/**
!/BZ_ASSETS_CORE/
/BZ_ASSETS_CORE/*
!/BZ_ASSETS_CORE/common/
/BZ_ASSETS_CORE/common/*
!/BZ_ASSETS_CORE/common/ui/
/BZ_ASSETS_CORE/common/ui/*
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/
/BZ_ASSETS_CORE/common/ui/CustomWidgets/*
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/osh_*.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uibtn.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uibtnhv.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uiline.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uiplate.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/odyssey.ogv

# Intentional root files
!/.gitignore
!/.gitattributes
