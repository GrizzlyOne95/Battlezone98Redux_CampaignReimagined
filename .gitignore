# Ignore unexpected runtime-flat root files by default
/*

# Allow GitHub automation and documentation
!/.github/
!/.github/**
!/docs/
!/docs/**
!/Docs/
!/Docs/**

# Allow source tree
!/_Source/

# Allow organized source folders
!/Assets/
!/Bin/
!/Config/
!/InstallerPayload/
!/InstallerPayload/**
!/flags/
!/Materials/
!/Missions/
!/ODF/
!/OverlayFont/
!/References/
!/Scripts/
!/Shaders/
# The shipping lock must be committed: its diff is how a change to what players
# receive gets reviewed. Regenerate with Manage-CampaignFiles.ps1 -bless.
!/Shipping/
!/Shipping/**
!/Text/
# Tools are source. Do not use a deny-all/whitelist here: new validators and
# maintenance scripts must appear in git status instead of being silently hidden.
!/Tools/

# OpenShim-owned files the lock ships, committed so a clean checkout is complete.
# Pinned to the commit in openshim/OPENSHIM_PIN.txt; refresh with Manage-CampaignFiles.ps1 -refresh-natives.
# Only these paths: the rest of BZ_ASSETS_CORE is the game's own content, not ours.
!/openshim/
!/openshim/**
!/BZ_ASSETS_CORE/
/BZ_ASSETS_CORE/*
!/BZ_ASSETS_CORE/common/
/BZ_ASSETS_CORE/common/*
!/BZ_ASSETS_CORE/common/ui/
/BZ_ASSETS_CORE/common/ui/*
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/
/BZ_ASSETS_CORE/common/ui/CustomWidgets/*
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/osh_*.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uibtn.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uibtnhv.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uiline.png
!/BZ_ASSETS_CORE/common/ui/CustomWidgets/uiplate.png

# Intentional root files
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/CHANGELOG.md
!/Manage-CampaignFiles.ps1
!/README.md
!/workshop.config.example.json
!/install/
!/install/install_windows.ps1
!/install.des
!/update.des
!/staged.des
!/nocopy.des
!/misn03cr.mpdes
!/misn04cr.mpdes
!/misn05cr.mpdes
!/misn06cr.mpdes
!/misn07cr.mpdes
!/misn08cr.mpdes
!/misn09cr.mpdes
!/misn10cr.mpdes
!/misn11cr.mpdes
!/misn12cr.mpdes
!/misn13cr.mpdes
!/misn14cr.mpdes
!/misn2bcr.mpdes

# Local machine/generated artifacts live under Local and stay ignored
/Local/

# Blender's authoring helpers import modules beside these build scripts.
/Tools/__pycache__/

# Ignore system files
thumbs.db
desktop.ini

# Ignore specific generated files inside tracked folders
/Config/fix_locations.csv
/Text/need_defs.txt
/Text/OgreMain.dumpbin.exports.txt

# Chunk meshes are no longer part of this repository or the pack: OpenShim
# generates them at runtime from the stock models. Assets/chunkMeshes*
# is excluded from the shipping set in Manage-CampaignFiles.ps1.

!misn15.mpdes

!misn16.mpdes

!misn17cr.mpdes

!misn18cr.mpdes
