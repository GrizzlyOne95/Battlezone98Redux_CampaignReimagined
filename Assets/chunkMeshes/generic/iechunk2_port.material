import * from "BZBase.material"

material iechunk2_BZBase_iechunks : BZBase
{
	set_texture_alias DiffuseMap generic/iechunks.dds
	set_texture_alias NormalMap generic/iechunks_n.dds
	set_texture_alias SpecularMap generic/iechunks_s.dds
	set_texture_alias EmissiveMap generic/iechunks_e.dds
	
	set $diffuse "1 1 1"
	set $ambient "1 1 1"
	set $specular ".7 .7 .7"
	set $shininess "127"
	set $glow "1 1 1"
}


