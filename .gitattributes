# Redux's native text BZN reader requires CRLF, including edited header lines.
# Empty native fields deliberately retain a space after '='.
*.bzn text eol=crlf whitespace=-blank-at-eol
# These restored stock BZNs retain their native binary payloads.
Missions/misns4.bzn binary
Missions/misns6.bzn binary
# Terrain rasters must remain byte-exact, including light maps with no NULs.
