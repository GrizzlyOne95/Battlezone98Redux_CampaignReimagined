# Redux's native text BZN reader requires CRLF, including edited header lines.
# Empty native fields deliberately retain a space after '='.
*.bzn text eol=crlf whitespace=-blank-at-eol
# Keep the tested stock terrain description byte format.
Missions/crsetup.trn whitespace=-blank-at-eol,-blank-at-eof
# Verbatim misn10 source and in-place cut-code comments retain original spacing.
# Disable newline conversion for the archive so its pinned Git blobs survive.
References/Misn10Source/* -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
Scripts/misn10.lua whitespace=-blank-at-eol
# Original DLL snapshots are pinned by Git blob ID. Preserve their CRLF and
# inherited whitespace even on checkouts that enable automatic text conversion.
References/Misn13Source/* -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Verbatim disabled C++ comments include whitespace-only lines.
Scripts/misn13.lua whitespace=-blank-at-eol
